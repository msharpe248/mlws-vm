; C structs in the declarative FFI, on Windows (ffi_struct says what
; .cstruct and the ways of passing one are). The Windows x64 calling
; convention returns a struct of 8 bytes in a register and a larger one through
; memory the caller provides, and passes one of 8 bytes by value in a
; register: div, lldiv and inet_ntoa cover each.
; requires: ffi
; requires: windows
; option: --ext-path build/test-ext
.include "std/test.inc"

; div_t and lldiv_t: what div() and lldiv() return, by value (8 bytes in a
; register, 16 through memory).
.cstruct DivT
    quot: i32
    rem: i32
.ends
.cstruct LLDivT
    quot: i64
    rem: i64
.ends

; struct in_addr, which inet_ntoa takes by value: the IPv4 address in network
; byte order. These tests run on little-endian machines, where 127.0.0.1 is
; the u32 0x0100007F.
.cstruct InAddr
    s_addr: u32
.ends

; struct tm, as the Windows C runtime declares it: nine ints.
.cstruct Tm
    tm_sec: i32
    tm_min: i32
    tm_hour: i32
    tm_mday: i32
    tm_mon: i32                ; 0 = January
    tm_year: i32               ; years since 1900
    tm_wday: i32               ; 0 = Sunday
    tm_yday: i32               ; 0 = January 1st
    tm_isdst: i32
.ends
; A time_t, for the functions that take a pointer to one.
.cstruct TimeT
    t: i64
.ends

; Every kind of field: a nested struct, number arrays (u8 arrays are byte
; buffers, others are lists), a cstr. C lays it out as
;   tag 0, x 8, ids 16..22, inner 24..32 (Inner: a 0, b 4, size 8), name 32,
;   raw 40..45, size 48 (a multiple of 8, x's alignment)
.cstruct Inner
    a: i32
    b: u8
.ends
.cstruct Rec
    tag: u8
    x: f64
    ids: u16[3]
    inner: struct Inner
    name: cstr
    raw: u8[5]
.ends

.extern c.div, "", "div" (i32, i32) -> (struct DivT)
.extern c.lldiv, "", "lldiv" (i64, i64) -> (struct LLDivT)
.extern c.inet_ntoa, "ws2_32", "inet_ntoa" (struct InAddr) -> (cstr)
.extern c.timegm, "", "_mkgmtime64" (struct* Tm) -> (i64)
.extern c.gmtime_s, "", "_gmtime64_s" (out struct Tm, struct* TimeT) -> (i32)
; memcpy copies one Rec into a fresh one: a round trip through C memory.
.extern c.copy_rec, "", "memcpy" (out struct Rec, struct* Rec, u64) -> (ptr)

.func main
    ; ---- returned by value ----
    ncall "c.div" (17, 5) -> (R0)
    ASSERT_EQ R0->DivT.quot, 3
    ASSERT_EQ R0->DivT.rem, 2
    ncall "c.lldiv" (-10000000000, 3) -> (R0)
    ASSERT_EQ R0->LLDivT.quot, -3333333333
    ASSERT_EQ R0->LLDivT.rem, -1

    ; ---- passed by value ----
    new R1, InAddr
    mov R1->InAddr.s_addr, 0x0100007F
    ncall "c.inet_ntoa" (R1) -> (R2)
    strcmp I0, R2, "127.0.0.1"
    ASSERT_EQ I0, 0

    ; ---- struct*: in and out ----
    ; _mkgmtime64 reads a broken-down UTC time and normalizes it in place:
    ; January 32nd 2000 becomes February 1st, a Tuesday, day 31 of the year.
    new R3, Tm
    mov R3->Tm.tm_mday, 32
    mov R3->Tm.tm_mon, 0
    mov R3->Tm.tm_year, 100
    ncall "c.timegm" (R3) -> (I1)
    ASSERT_EQ I1, 949363200            ; 2000-02-01T00:00:00Z
    ASSERT_EQ R3->Tm.tm_mon, 1         ; copied back
    ASSERT_EQ R3->Tm.tm_mday, 1
    ASSERT_EQ R3->Tm.tm_wday, 2
    ASSERT_EQ R3->Tm.tm_yday, 31

    ; ---- out struct ----
    new R4, TimeT
    mov R4->TimeT.t, 951782400         ; 2000-02-29T00:00:00Z, a leap day
    ncall "c.gmtime_s" (R4) -> (I2, R6) ; the return value first, then the out struct
    ASSERT_EQ I2, 0
    ASSERT_EQ R6->Tm.tm_year, 100
    ASSERT_EQ R6->Tm.tm_mon, 1
    ASSERT_EQ R6->Tm.tm_mday, 29
    ASSERT_EQ R6->Tm.tm_yday, 59
    ASSERT_EQ R6->Tm.tm_wday, 2        ; a Tuesday

    ; ---- every kind of field, through C memory and back ----
    new R7, Rec
    mov R7->Rec.tag, 200
    mov R7->Rec.x, 2.5
    lnew R8
    lpush.u16 R8, 1, 65535, 3
    mov R7->Rec.ids, R8
    new R9, Inner
    mov R9->Inner.a, -42
    mov R9->Inner.b, 7
    mov R7->Rec.inner, R9
    mov R7->Rec.name, "ok"
    bufnew R10, 2                      ; a short buffer: the rest of raw is 0
    mov R10[0], 9
    mov R10[1], 8
    mov R7->Rec.raw, R10
    ncall "c.copy_rec" (R7, 48) -> (R11, R12)
    ASSERT_EQ R12->Rec.tag, 200
    ASSERT_EQ R12->Rec.x, 2.5
    mov R13, R12->Rec.ids              ; a list of 3 u16 values
    len I3, R13
    ASSERT_EQ I3, 3
    ASSERT_EQ R13[1], 65535
    mov R14, R12->Rec.inner
    ASSERT_EQ R14->Inner.a, -42
    ASSERT_EQ R14->Inner.b, 7
    strcmp I4, R12->Rec.name, "ok"
    ASSERT_EQ I4, 0
    mov R15, R12->Rec.raw              ; a byte buffer of all 5 bytes
    len I5, R15
    ASSERT_EQ I5, 5
    ASSERT_EQ R15[1], 8
    ASSERT_EQ R15[4], 0

    ; a null nested struct is all zeros, and reads back as a new one
    mov R7->Rec.inner, null
    ncall "c.copy_rec" (R7, 48) -> (R11, R12)
    mov R14, R12->Rec.inner
    ASSERT_EQ R14->Inner.a, 0

    ; ---- wrong arguments ----
.try h1
    ncall "c.inet_ntoa" (R3)           ; a Tm is not an InAddr
.endtry
    FAIL "a Tm was passed as an InAddr"
h1: catch R16
    strcmp I6, R16->Error.code, "E_TYPE"
    ASSERT_EQ I6, 0
    ret 0
.endf
