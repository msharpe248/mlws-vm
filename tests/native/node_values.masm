; What crosses between nodes: every kind of value keeps its type and contents
; through node.frame and node.decode, and what cannot cross raises E_TYPE. What
; arrives from the network is not trusted, so bytes that are random, or a good
; frame with bytes changed or cut short, must give E_PARSE or a value, and never
; anything worse: a length is checked against what is left, and so is each
; reference to an object met before. Sharing and cycles cross as a local send
; keeps them, and a value as deep as a long list of cells crosses too.
.include "std/test.inc"

.struct Pair
    left: i64
    right: ref
.ends

; A frame's value after a trip: the frame without its 4-byte length.
.func body(ref frame) -> ref
    len I1, frame
    sub I2, I1, 4
    bufnew R2, I2
    mov I3, 0
1:  bge I3, I2, 2f
    add I4, I3, 4
    mov I5, frame[I4]
    mov R2[I3], I5
    inc I3
    jmp 1b
2:  ret R2
.endf

.func trip(ref v) -> ref
    ncall "node.frame" (v) -> (R1)
    call body (R1) -> (R2)
    ncall "node.decode" (R2) -> (R3)
    ret R3
.endf

; A decode that may fail: 1 if it gave a value, 0 if E_PARSE or E_TYPE.
.func try_decode(ref bytes) -> i64
.try h
    ncall "node.decode" (bytes) -> (R1)
.endtry
    ret 1
h:
    catch R2
    strcmp I1, R2->Error.code, "E_PARSE"
    bz I1, 1f
    strcmp I1, R2->Error.code, "E_TYPE"
    ASSERT_EQ I1, 0
1:  ret 0
.endf

; What sending this raises, or null.
.func send_error(ref v) -> ref
.try h
    ncall "node.frame" (v) -> (R1)
.endtry
    ret null
h:
    catch R2
    mov R3, R2->Error.code
    ret R3
.endf

.func f
    ret
.endf

; Adds UP[0]: a closure's function, to send with what it captured.
.func plus(i64 x) -> i64
    mov I1, UP[0]
    add I0, x, I1
    ret I0
.endf

; The closure's capture, UP[0].
.func up0 -> ref
    mov R1, UP[0]
    ret R1
.endf

; What is shared stays shared: one object where it was one, and a new one,
; not the sender's.
.func shared
    strcat R1, "made", " here"
    mnew R2
    mset R2, "k", 1
    lnew R3
    lpush R3, R1
    lpush R3, R1
    lpush R3, R2
    lpush R3, R2
    call trip (R3) -> (R4)
    mov R5, R4[0]
    mov R6, R4[1]
    ASSERT_EQ R5, R6, r
    ASSERT_NE R5, R1, r
    strcmp I1, R5, "made here"
    ASSERT_EQ I1, 0
    mov R5, R4[2]
    mov R6, R4[3]
    ASSERT_EQ R5, R6, r
    ASSERT_NE R5, R2, r
    ; A map keyed by an object (by identity) still finds the key sent with it.
    lnew R7
    mnew R8
    mset R8, R7, 99
    lnew R9
    lpush R9, R8
    lpush R9, R7
    call trip (R9) -> (R10)
    mov R11, R10[0]
    mov R12, R10[1]
    ASSERT_NE R12, R7, r
    mget I2, R11, R12
    ASSERT_EQ I2, 99
    ret
.endf

; A value that holds itself: through a list, a struct, a map (as a value and
; as a key) and a closure's capture.
.func cycles
    lnew R1
    lpush R1, R1
    call trip (R1) -> (R2)
    mov R3, R2[0]
    ASSERT_EQ R3, R2, r
    ASSERT_NE R2, R1, r

    new R4, Pair
    mov R4->Pair.left, 3
    lnew R5
    lpush R5, R4
    mov R4->Pair.right, R5
    call trip (R4) -> (R6)
    mov R7, R6->Pair.right
    mov R8, R7[0]
    ASSERT_EQ R8, R6, r
    mov I1, R8->Pair.left
    ASSERT_EQ I1, 3

    mnew R9
    mset R9, "self", R9
    mset R9, R9, "key"
    call trip (R9) -> (R10)
    mget R11, R10, "self"
    ASSERT_EQ R11, R10, r
    mget R12, R10, R10
    strcmp I2, R12, "key"
    ASSERT_EQ I2, 0
    len I3, R10
    ASSERT_EQ I3, 2

    lnew R13
    closure up0 (R13) -> R14
    lpush R13, R14
    call trip (R14) -> (R15)
    calli R15 () -> (R16)
    mov R17, R16[0]
    ASSERT_EQ R17, R15, r
    ret
.endf

; Deep values: 100,000 structs each holding the next, and lists as deep, as a
; language's list of cells is.
.func deep
    mov R1, null
    mov I1, 0
1:  new R2, Pair
    mov R2->Pair.left, I1
    mov R2->Pair.right, R1
    mov R1, R2
    inc I1
    blt I1, 100000, 1b
    call trip (R1) -> (R3)
    mov I2, 0
2:  bz.r R3, 3f
    mov I3, R3->Pair.left
    sub I4, 99999, I2
    ASSERT_EQ I3, I4
    mov R3, R3->Pair.right
    inc I2
    jmp 2b
3:  ASSERT_EQ I2, 100000

    lnew R4
    mov R5, R4
    mov I1, 0
4:  lnew R6
    lpush R5, R6
    mov R5, R6
    inc I1
    blt I1, 100000, 4b
    call trip (R4) -> (R7)
    mov I2, 0
5:  len I5, R7
    bz I5, 6f
    mov R7, R7[0]
    inc I2
    jmp 5b
6:  ASSERT_EQ I2, 100000
    ret
.endf

; Frames no sender writes: a reference to an object not met yet, and a
; BigInt's type holding a string, are refused (E_PARSE); a reference back to
; the list being read is a list that holds itself.
.func forged
    ncall "hex.decode" ("0d05010000000df305000000") -> (R1)
    call try_decode (R1) -> (I1)
    ASSERT_EQ I1, 0
    ncall "hex.decode" ("0d05010000000f010100000037") -> (R1)
    call try_decode (R1) -> (I1)
    ASSERT_EQ I1, 0
    ncall "hex.decode" ("0d05010000000df300000000") -> (R1)
    ncall "node.decode" (R1) -> (R2)
    mov R3, R2[0]
    ASSERT_EQ R3, R2, r
    ret
.endf

.func main
    ; Every kind, inside a list so that each keeps its tag.
    lnew R0
    lpush R0, 42
    lpush R0, -1
    lpush R0, 2.5
    lpush R0, "text"
    mov R20, null
    lpush R0, R20
    lpush R0, 12345678901234567890n
    lpush R0, 19.99d
    bufnew R1, 2
    mov R1[0], 200
    lpush R0, R1
    anew.f64 R2, 2
    mov R2[1], 1.5
    lpush R0, R2
    new R3, Pair
    mov R3->Pair.left, 7
    mov R3->Pair.right, "right"
    lpush R0, R3
    mnew R4
    mset R4, "k", 1
    mset R4, 5, "v"
    lpush R0, R4
    strcat R21, "a capture"
    closure plus (30, R21) -> R22
    lpush R0, R22
    lnew R5
    lpush R5, R0
    call trip (R5) -> (R6)
    mov R7, R6[0]
    len I0, R7
    ASSERT_EQ I0, 12
    mov I1, R7[0]
    ASSERT_EQ I1, 42
    mov I1, R7[1]
    ASSERT_EQ I1, -1
    mov F0, R7[2]
    ASSERT_EQ F0, 2.5
    mov R8, R7[3]
    strcmp I1, R8, "text"
    ASSERT_EQ I1, 0
    mov R8, R7[4]
    ASSERT_FALSE R8, r
    mov R8, R7[5]
    typeof I1, R8
    ASSERT_EQ I1, 8
    tostr R9, R8
    strcmp I1, R9, "12345678901234567890"
    ASSERT_EQ I1, 0
    mov R8, R7[6]
    tostr R9, R8
    strcmp I1, R9, "19.99"
    ASSERT_EQ I1, 0
    mov R8, R7[7]
    mov I1, R8[0]
    ASSERT_EQ I1, 200
    mov R8, R7[8]
    mov F0, R8[1]
    ASSERT_EQ F0, 1.5
    mov R8, R7[9]
    mov I1, R8->Pair.left
    ASSERT_EQ I1, 7
    mov R9, R8->Pair.right
    strcmp I1, R9, "right"
    ASSERT_EQ I1, 0
    mov R8, R7[10]
    mget I1, R8, "k"
    ASSERT_EQ I1, 1
    mget R9, R8, 5
    strcmp I1, R9, "v"
    ASSERT_EQ I1, 0
    mov R8, R7[11]                     ; the same function, its captures with it
    calli R8 (12) -> (I1)
    ASSERT_EQ I1, 42

    ; An interned string (a literal, text.intern's) comes back the very
    ; object, as every module's literal of it; another is a string of its own.
    lnew R24
    lpush R24, "an atom"
    strcat R25, "an", " atom"
    lpush R24, R25
    strcat R26, "made", " here"
    ncall "text.intern" (R26) -> (R26)
    lpush R24, R26
    call trip (R24) -> (R27)
    mov R28, R27[0]
    beq.r R28, "an atom", 1f
    FAIL "a literal came back another object"
1:  mov R28, R27[1]
    bne.r R28, "an atom", 1f
    FAIL "a string made here came back the literal"
1:  strcmp I1, R28, "an atom"
    ASSERT_EQ I1, 0
    mov R28, R27[2]
    ncall "text.intern" ("made here") -> (R29)
    beq.r R28, R29, 1f
    FAIL "an interned string came back another object"
1:
    ; So with a BigInt or decimal literal, however it is spelled; a number
    ; made here is a number of its own.
    lnew R24
    mov.r R25, 0d
    lpush R24, R25
    mov.r R25, 007n
    lpush R24, R25
    mov.r R26, 1d
    add.dec R27, R26, R26              ; 2d, made here
    lpush R24, R27
    call trip (R24) -> (R28)
    mov R29, R28[0]
    beq.r R29, 0d, 1f
    FAIL "a decimal literal came back another object"
1:  mov R29, R28[1]
    beq.r R29, 7n, 1f
    FAIL "a BigInt literal came back another object"
1:  mov R29, R28[2]
    bne.r R29, 2d, 1f
    FAIL "a decimal made here came back a literal"
1:
    ; What is of this VM alone stays.
    closure f -> (R10)
    conew R23, R10
    lnew R11
    lpush R11, R23
    call send_error (R11) -> (R12)
    strcmp I1, R12, "E_TYPE"
    ASSERT_EQ I1, 0
    call shared
    call cycles
    call deep
    call forged

    ; Random bytes.
    mov I2, 0
1:  ncall "random.int" (0, 40) -> (I3)
    ncall "random.bytes" (I3) -> (R14)
    call try_decode (R14) -> (I4)
    inc I2
    blt I2, 3000, 1b

    ; A good frame, with a byte changed, again and again.
    ncall "node.frame" (R5) -> (R15)
    call body (R15) -> (R16)
    len I5, R16
    mov I2, 0
2:  bufnew R17, I5
    bufcat R17, R16
    ncall "random.int" (0, I5) -> (I6)
    sub I7, I5, 1
    ble I6, I7, 3f
    mov I6, I7
3:  ncall "random.int" (0, 255) -> (I8)
    add I9, I6, I5
    mov R17[I9], I8
    call try_decode (R17) -> (I4)
    inc I2
    blt I2, 3000, 2b

    ; Cut short, at every length.
    mov I2, 0
4:  bge I2, I5, 6f
    bufnew R18, I2
    mov I3, 0
5:  bge I3, I2, 7f
    mov I6, R16[I3]
    mov R18[I3], I6
    inc I3
    jmp 5b
7:  call try_decode (R18) -> (I4)
    ASSERT_EQ I4, 0
    inc I2
    jmp 4b
6:  ret 0
.endf
