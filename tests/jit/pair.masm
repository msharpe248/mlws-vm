; A value's two words, as the compilers read them, are one form in the JIT
; (src/vm/jit.inc, jit_pair): compiled Lua's `mov R, X[i]` and then
; `ldv I, F, X[i+1]`, and compiled Lox's `mov.f64 F, X[i]` and then
; `mov.r R, X[i+1]` (any two loads of different banks). One check that X is
; a list, then both loads. Every result must be the interpreter's:
;   * a reference and an i64, a reference and an f64, null and never-written
;     words (zeros);
;   * an integer of another type at i+1 (u8): the ldv's side exit, after the
;     first load is done (its R register is the one returned);
;   * i+1 past the list's end (E_BOUNDS from the ldv; the first load done);
;   * not a list: an array of references (E_TYPE from the ldv), null (E_NULL
;     from the first), a struct;
;   * the ldv's I destination the index register itself;
;   * another element of the same list read later in the block (it is known
;     to be a list there, and is still bounds checked);
;   * the first's destination the list's own register, or the index register
;     (no pair);
;   * Lox's f64 and reference, an i64 and an f64, an element of another type
;     at either word (side exits), never-written words, and an array of f64
;     (the first load, then E_TYPE).
; option: --jit all
.include "std/test.inc"

.struct S
    a: i64
.ends

.macro EXPECT_ERROR code, insn...
.try .Lh\@
    \insn
.endtry
    FAIL "an error was expected"
.Lh\@:
    catch R31
    strcmp I31, R31->Error.code, \code
    ASSERT_EQ I31, 0
.endm

; Value k of a two-word list: its reference word and its number word.
.func value(ref l, i64 k) -> (ref, i64, f64)
    mov I2, -1
    mov.f64 F2, -1.0
    add I1, k, k
    mov R1, l[I1]
    ldv I2, F2, l[I1+1]
    ret R1, I2, F2
.endf

; The same, with an error caught: the first load's register as it was left.
.func value_or(ref l, i64 k) -> (ref, i64)
    mov.r R1, "unset"
.try 9f
    add I1, k, k
    mov R1, l[I1]
    ldv I2, F2, l[I1+1]
.endtry
    ret R1, 0
9:  catch R5
    strcmp I3, R5->Error.code, "E_BOUNDS"
    bz I3, 1f
    strcmp I3, R5->Error.code, "E_TYPE"
    bz I3, 2f
    strcmp I3, R5->Error.code, "E_NULL"
    bz I3, 3f
    ret R1, 9
1:  ret R1, 1
2:  ret R1, 2
3:  ret R1, 3
.endf

; ldv into its own index register.
.func into_index(ref l, i64 k) -> (ref, i64, f64)
    add I1, k, k
    mov R1, l[I1]
    ldv I1, F1, l[I1+1]
    ret R1, I1, F1
.endf

; After the pair, element j of the same list, in the same block.
.func then_other(ref l, i64 k, i64 j) -> (ref, i64, ref)
    add I3, k, k
    mov R1, l[I3]
    ldv I2, F2, l[I3+1]
    mov R2, l[j]
    ret R1, I2, R2
.endf

; The first load replaces the list's register: two instructions, as written.
.func self_load(ref l) -> (i64, f64)
    mov I1, 0
    mov R0, l[I1]
    ldv I2, F2, R0[I1+1]
    ret I2, F2
.endf

; Lox's shape: the number word, then the reference word.
.func lox_value(ref l, i64 k) -> (f64, ref)
    add I1, k, k
    mov.f64 F1, l[I1]
    mov.r R1, l[I1+1]
    ret F1, R1
.endf

; An i64, then an f64.
.func int_float(ref l, i64 k) -> (i64, f64)
    add I1, k, k
    mov I2, l[I1]
    mov.f64 F2, l[I1+1]
    ret I2, F2
.endf

; The first load replaces the index register: two instructions, as written.
.func index_load(ref l) -> (i64, f64)
    mov I1, 0
    mov I1, l[I1]
    mov.f64 F1, l[I1+1]
    ret I1, F1
.endf

; Lox's shape with an error caught: the first load's register as it was left.
.func lox_or(ref l, i64 k) -> (f64, i64)
    mov.f64 F1, -1.0
.try 9f
    add I1, k, k
    mov.f64 F1, l[I1]
    mov.r R1, l[I1+1]
.endtry
    ret F1, 0
9:  catch R5
    strcmp I3, R5->Error.code, "E_TYPE"
    bz I3, 1f
    ret F1, 9
1:  ret F1, 2
.endf

.func main
    lnew R0, 8
    mov.r R8, "int"
    lpush R0, R8, 42                     ; value 0: a reference and an i64
    mov.r R8, "float"
    lpush R0, R8, 2.5                    ; value 1: a reference and an f64
    mov.r R8, null
    lpush R0, R8                         ; value 2: null, then
    lpush.u8 R0, 7                       ;   a u8
    resize R0, 8                         ; value 3: never written

    call value (R0, 0) -> (R1, I1, F1)
    strcmp I9, R1, "int"
    ASSERT_EQ I9, 0
    ASSERT_EQ I1, 42
    ASSERT_EQ F1, 0.0
    call value (R0, 1) -> (R1, I1, F1)
    strcmp I9, R1, "float"
    ASSERT_EQ I9, 0
    ASSERT_EQ I1, 0
    ASSERT_EQ F1, 2.5
    call value (R0, 2) -> (R1, I1, F1)     ; the u8: the ldv's side exit
    ASSERT_FALSE R1
    ASSERT_EQ I1, 7
    ASSERT_EQ F1, 0.0
    call value (R0, 3) -> (R1, I1, F1)     ; never written: zeros
    ASSERT_FALSE R1
    ASSERT_EQ I1, 0
    ASSERT_EQ F1, 0.0

    ; i+1 past the end: the first load done, the ldv's E_BOUNDS
    lnew R2
    mov.r R8, "last"
    lpush R2, R8, 5
    lpush R2, R8                          ; length 3: value 1 has no number word
    call value_or (R2, 1) -> (R3, I3)
    ASSERT_EQ I3, 1
    strcmp I9, R3, "last"
    ASSERT_EQ I9, 0
    call value_or (R2, 2) -> (R3, I3)     ; i itself past the end
    ASSERT_EQ I3, 1
    strcmp I9, R3, "unset"
    ASSERT_EQ I9, 0

    ; not a list
    anew.r R4, 4
    mov.r R8, "elem"
    mov R4[0], R8
    call value_or (R4, 0) -> (R3, I3)     ; an array: the first load, then E_TYPE
    ASSERT_EQ I3, 2
    strcmp I9, R3, "elem"
    ASSERT_EQ I9, 0
    mov.r R5, null
    call value_or (R5, 0) -> (R3, I3)     ; null
    ASSERT_EQ I3, 3
    new R6, S
    call value_or (R6, 0) -> (R3, I3)     ; a struct has no elements
    ASSERT_EQ I3, 2

    call into_index (R0, 1) -> (R1, I1, F1)
    strcmp I9, R1, "float"
    ASSERT_EQ I9, 0
    ASSERT_EQ I1, 0
    ASSERT_EQ F1, 2.5
    call into_index (R0, 0) -> (R1, I1, F1)
    ASSERT_EQ I1, 42

    call then_other (R0, 0, 2) -> (R1, I1, R2)
    ASSERT_EQ I1, 42
    strcmp I9, R2, "float"
    ASSERT_EQ I9, 0
    EXPECT_ERROR "E_BOUNDS", call then_other (R0, 1, 99) -> (R1, I1, R2)

    lnew R7
    lpush R7, R0                          ; R7[0] is the list above
    call self_load (R7) -> (I1, F1)       ; R0 := R7[0], then R0[1]: 42
    ASSERT_EQ I1, 42
    ASSERT_EQ F1, 0.0

    ; Lox's shape
    lnew R10
    mov.r R8, "a"
    lpush.f64 R10, 1.5
    lpush R10, R8                         ; value 0: 1.5, "a"
    lpush.f64 R10, 2.5
    lpush.i64 R10, 3                      ; value 1: an i64 where the reference goes
    lpush R10, R8
    lpush R10, R8                         ; value 2: a reference where the f64 goes
    resize R10, 8                         ; value 3: never written
    call lox_value (R10, 0) -> (F1, R1)
    ASSERT_EQ F1, 1.5
    strcmp I9, R1, "a"
    ASSERT_EQ I9, 0
    call lox_or (R10, 1) -> (F1, I1)      ; the second's E_TYPE, the first done
    ASSERT_EQ I1, 2
    ASSERT_EQ F1, 2.5
    call lox_or (R10, 2) -> (F1, I1)      ; the first's E_TYPE
    ASSERT_EQ I1, 2
    ASSERT_EQ F1, -1.0
    call lox_value (R10, 3) -> (F1, R1)   ; never written: zero and null
    ASSERT_EQ F1, 0.0
    ASSERT_FALSE R1
    anew.f64 R11, 4
    mov.f64 R11[0], 4.5
    call lox_or (R11, 0) -> (F1, I1)      ; an array: its f64, then E_TYPE
    ASSERT_EQ I1, 2
    ASSERT_EQ F1, 4.5

    ; an i64, then an f64
    lnew R12
    lpush.i64 R12, 6
    lpush.f64 R12, 0.25
    lpush.f64 R12, 9.0                    ; value 1: an f64 where the i64 goes
    lpush.f64 R12, 1.0
    call int_float (R12, 0) -> (I1, F1)
    ASSERT_EQ I1, 6
    ASSERT_EQ F1, 0.25
    EXPECT_ERROR "E_TYPE", call int_float (R12, 1) -> (I1, F1)

    lnew R13
    lpush.i64 R13, 1                      ; R13[0] = 1: the index of the f64 after it
    lpush.f64 R13, 0.0
    lpush.f64 R13, 7.5
    call index_load (R13) -> (I1, F1)     ; I1 := 1, then R13[2]
    ASSERT_EQ I1, 1
    ASSERT_EQ F1, 7.5
    ret 0
.endf
