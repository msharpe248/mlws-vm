; P{n}: base register + displacement in bytes. Memory is little-endian.
.include "std/test.inc"
.func main
    alloc P0, 16
    mov.u8 P0{0}, 1
    mov.u8 P0{1}, 2
    ASSERT_EQ P0{0}, 0x0201, u16
    mov.u32 P0{4}, 0xDEADBEEF
    ASSERT_EQ P0{4}, 0xDEADBEEF, u32
    ASSERT_EQ P0[0], 0xDEADBEEF00000201, u64
    mov.i16 P0{9}, -2          ; unaligned access is fine
    ASSERT_EQ P0{9}, -2, i16
    ASSERT_EQ P0{9}, 0xFE, u8
    mov.f32 P0{12}, 2.5
    ASSERT_EQ P0{12}, 2.5, f32
    mov.u8 [P0], 7             ; [P] is an indirect (displacement 0)
    ASSERT_EQ P0{0}, 7, u8
    free P0
    ret 0
.endf
