; (diagnostics while porting to Windows: many_idle with progress)
.include "std/test.inc"
.include "std/io.inc"
.const N = 5
.func handler(i64 ticket)
    ncall "fs.take" (ticket) -> (R0)
    PRINTLN_S "handler reads"
    ncall "fs.read_line" (R0) -> (R1)
    PRINTLN_S "handler got a line"
    strcat R2, R1, "\n"
    ncall "fs.write" (R0, R2)
    ncall "fs.close" (R0)
    ret
.endf
.func client(i64 parent, i64 port)
    ncall "net.connect" ("127.0.0.1", port, 10000) -> (R0)
    PRINTLN_S "client connected"
    send parent, 1
    recv I1
    ncall "fs.write" (R0, "ping\n")
    PRINTLN_S "client wrote"
    ncall "fs.read_line" (R0) -> (R1)
    PRINTLN_S "client read"
    strcmp I2, R1, "ping"
    send parent, I2
    ret
.endf
.func main
    ncall "net.listen" ("127.0.0.1", 0) -> (R0)
    ncall "net.port" (R0) -> (I0)
    alloc P0, N * 8
    mov I1, 0
1:  spawn client (PID, I0) -> (I2)
    mov P0[I1], I2
    PRINTLN_S "main accepts"
    ncall "net.accept" (R0) -> (R1)
    PRINTLN_S "main accepted"
    ncall "fs.give" (R1) -> (I3)
    spawn handler (I3)
    recv I4
    PRINTLN_I I1
    inc I1
    blt I1, N, 1b
    mov I1, 0
2:  mov I2, P0[I1]
    send I2, 0
    inc I1
    blt I1, N, 2b
    mov I1, 0
3:  recv I4
    PRINTLN_S "main: a client is done"
    inc I1
    blt I1, N, 3b
    ret 0
.endf
