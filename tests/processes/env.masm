; Environments: values in the VM that a set of processes shares (env.*), not
; the operating system's. A program's processes share its environment: what
; one sets, the others see at once; each get is a copy of its own. A process
; may join a named environment, as may those it then spawns; "" is its
; program's again. env.watch sends an EnvChange for each change. A restricted
; process reads, and changes nothing. env.load reads a file of name = JSON
; lines (_env/app.mlws.env), with ${VAR} from the operating system's.
; env.get_any reads a value of any type into a list slot, for tagof.
.include "std/test.inc"

; Sets "from child" to 7, then answers parent with what it sees of "shared".
.func child(i64 parent)
    ncall "env.set_i" ("from child", 7)
    ncall "env.get" ("shared", null) -> (R1)
    send parent, R1
    ret
.endf

; Reports its environment's name and "where" to parent.
.func reporter(i64 parent)
    ncall "env.name" () -> (R1)
    ncall "env.get" ("where", "none") -> (R2)
    lnew R3
    lpush R3, R1, R2
    send parent, R3
    ret
.endf

; What setting a value raises, in a restricted process, to parent.
.func restricted(i64 parent)
    mnew R0
    ncall "cap.restrict" (R0)
    ncall "env.get" ("shared", null) -> (R1)
.try h
    ncall "env.set" ("shared", "no")
.endtry
    send parent, "not raised"
    ret
h:  catch R2
    mov R3, R2->Error.code
    lnew R4
    lpush R4, R1, R3
    send parent, R4
    ret
.endf

.func get_code(ref name) -> ref
.try h
    ncall "env.get" (name, null) -> (R1)
.endtry
    ret null
h:  catch R2
    mov R3, R2->Error.code
    ret R3
.endf

.func main
    ; Missing: the default.
    ncall "env.get" ("nothing", "default") -> (R1)
    strcmp I1, R1, "default"
    ASSERT_EQ I1, 0
    ncall "env.get_i" ("nothing", 5) -> (I2)
    ASSERT_EQ I2, 5
    ncall "env.has" ("nothing") -> (I3)
    ASSERT_FALSE I3

    ; Set and get, each type; a list comes back a copy of its own.
    lnew R2
    lpush R2, 1, 2, 3
    ncall "env.set" ("shared", R2)
    ncall "env.set_i" ("count", 42)
    ncall "env.set_f" ("ratio", 1.5)
    ncall "env.get" ("shared", null) -> (R3)
    len I4, R3
    ASSERT_EQ I4, 3
    ASSERT_NE R3, R2, r
    lpush R3, 4                        ; (the copy only)
    ncall "env.get" ("shared", null) -> (R4)
    len I4, R4
    ASSERT_EQ I4, 3
    ncall "env.get_i" ("count", 0) -> (I5)
    ASSERT_EQ I5, 42
    ncall "env.get_f" ("ratio", 0.0) -> (F1)
    ASSERT_EQ F1, 1.5
    call get_code ("count") -> (R5)    ; a number by env.get: E_TYPE
    strcmp I1, R5, "E_TYPE"
    ASSERT_EQ I1, 0

    ; A child shares it.
    spawn child (PID) -> (I6)
    recv R6
    len I4, R6
    ASSERT_EQ I4, 3
    ncall "env.get_i" ("from child", 0) -> (I7)
    ASSERT_EQ I7, 7

    ; Watching: a change by another process comes as an EnvChange.
    ncall "env.watch" (1)
    spawn child (PID) -> (I6)
    recv R7                            ; (the EnvChange or the child's answer, in either order)
    recv R8
    isa I8, R7, EnvChange
    isa I9, R8, EnvChange
    or I8, I8, I9
    ASSERT_TRUE I8
    ncall "env.watch" (0)

    ; Keys and delete.
    ncall "env.keys" () -> (R9)
    len I4, R9
    ASSERT_EQ I4, 4                    ; shared, count, ratio, from child
    ncall "env.delete" ("ratio")
    ncall "env.has" ("ratio") -> (I3)
    ASSERT_FALSE I3

    ; A named environment: this process and what it spawns from now on;
    ; "" is the program's again.
    ncall "env.join" ("billing")
    ncall "env.set" ("where", "billing")
    ncall "env.has" ("shared") -> (I3)
    ASSERT_FALSE I3
    spawn reporter (PID) -> (I6)
    recv R10
    mov R11, R10[0]
    strcmp I1, R11, "billing"
    ASSERT_EQ I1, 0
    mov R11, R10[1]
    strcmp I1, R11, "billing"
    ASSERT_EQ I1, 0
    ncall "env.join" ("")
    ncall "env.get" ("where", "none") -> (R12)
    strcmp I1, R12, "none"
    ASSERT_EQ I1, 0
    ncall "env.has" ("shared") -> (I3)
    ASSERT_TRUE I3

    ; A restricted process reads, and changes nothing.
    spawn restricted (PID) -> (I6)
    recv R13
    mov R14, R13[1]
    strcmp I1, R14, "E_PERMISSION"
    ASSERT_EQ I1, 0
    mov R14, R13[0]
    len I4, R14
    ASSERT_EQ I4, 3

    ; A file.
    ncall "env.load" ("tests/processes/_env/app.mlws.env")
    ncall "env.get" ("greeting", null) -> (R15)
    strcmp I1, R15, "hello"
    ASSERT_EQ I1, 0
    ncall "env.get_i" ("port", 0) -> (I10)
    ASSERT_EQ I10, 8080
    ncall "env.get_f" ("ratio", 0.0) -> (F2)
    ASSERT_EQ F2, 0.5
    ncall "env.get" ("servers", null) -> (R16)
    len I4, R16
    ASSERT_EQ I4, 2
    ncall "env.get" ("limits", null) -> (R17)
    mget I11, R17, "max"
    ASSERT_EQ I11, 3
    ncall "env.get" ("path", null) -> (R18)
    ncall "os.env" ("PATH") -> (R19)
    strcmp I1, R18, R19
    ASSERT_EQ I1, 0

    ; Any type, as the only element of a list: tagof tells a boolean from an
    ; integer; none is an empty list.
    ncall "env.get_any" ("debug") -> (R20)
    len I4, R20
    ASSERT_EQ I4, 1
    tagof I12, R20[0]
    ASSERT_EQ I12, 1                   ; b
    ncall "env.get_any" ("port") -> (R20)
    tagof I12, R20[0]
    ASSERT_EQ I12, 6                   ; i64
    mov I13, R20[0]
    ASSERT_EQ I13, 8080
    ncall "env.get_any" ("ratio") -> (R20)
    tagof I12, R20[0]
    ASSERT_EQ I12, 12                  ; f64
    ncall "env.get_any" ("greeting") -> (R20)
    tagof I12, R20[0]
    ASSERT_EQ I12, 13                  ; r
    mov R21, R20[0]
    strcmp I1, R21, "hello"
    ASSERT_EQ I1, 0
    ncall "env.get_any" ("nothing") -> (R20)
    len I4, R20
    ASSERT_EQ I4, 0
    ret
.endf
