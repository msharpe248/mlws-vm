; Spawn 2000 processes; each computes a value and reports it. Finished
; processes are reclaimed immediately.
.include "std/test.inc"
.func worker(i64 parent, i64 n)
    mul I2, n, n
    send parent, I2
    ret
.endf
.func main
    mov I0, 0
1:  spawn worker (PID, I0)
    inc I0
    blt I0, 2000, 1b
    mov I1, 0                          ; sum of squares 0..1999
    mov I0, 0
2:  recv I2
    add I1, I2
    inc I0
    blt I0, 2000, 2b
    ASSERT_EQ I1, 2664667000
    mov I4, 0                          ; the last workers may still be finishing,
3:  ncall "proc.count" () -> (I3)      ; on other threads: wait (up to a second)
    beq I3, 1, 4f
    sleep 1
    inc I4
    blt I4, 1000, 3b
4:  ASSERT_EQ I3, 1
    ret 0
.endf
