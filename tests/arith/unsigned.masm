; Unsigned types use unsigned division, remainder, comparison and min/max.
.include "std/test.inc"
.func main
    div.u64 I0, -1, 2
    ASSERT_EQ I0, 9223372036854775807
    div.i64 I1, -1, 2
    ASSERT_EQ I1, 0
    rem.u8 I2, 250, 7
    ASSERT_EQ I2, 5
    min.u64 I3, -1, 5
    ASSERT_EQ I3, 5
    max.i64 I4, -1, 5, 3
    ASSERT_EQ I4, 5
    mov I5, -1
    blt.u64 I5, 1, bad      ; 0xFFFF... is not < 1 unsigned
    blt.i64 I5, 1, ok       ; but -1 < 1 signed
bad:
    FAIL "unsigned/signed compare"
ok:
    ret 0
.endf
