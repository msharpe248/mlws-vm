; Bitwise logic, shifts and rotates within the type's width, and bit counting.
.include "std/test.inc"
.func main
    and I0, 0xF0F0, 0xFF00
    ASSERT_EQ I0, 0xF000
    or I0, 0x0F
    ASSERT_EQ I0, 0xF00F
    xor I0, 0xFFFF
    ASSERT_EQ I0, 0x0FF0
    not I1, 0
    ASSERT_EQ I1, -1
    not.b I2, 0
    ASSERT_EQ I2, 1
    shl.i8 I3, 1, 7
    ASSERT_EQ I3, -128
    shl.u8 I3, 1, 8            ; count is taken modulo 8
    ASSERT_EQ I3, 1
    shr.i8 I4, -128, 7         ; logical: zero fill within 8 bits
    ASSERT_EQ I4, 1
    sar.i8 I4, -128, 7
    ASSERT_EQ I4, -1
    sar.u8 I4, 0x80, 7
    ASSERT_EQ I4, 255
    rol.u8 I5, 0x81, 1
    ASSERT_EQ I5, 0x03
    ror.u8 I5, 0x81, 1
    ASSERT_EQ I5, 0xC0
    rol.i64 I5, 1, 63
    ASSERT_EQ I5, 0x8000000000000000
    mov I6, 3
    shl I6, 4                  ; two-operand form
    ASSERT_EQ I6, 48
    popcnt.u64 I7, 0xFF
    ASSERT_EQ I7, 8
    popcnt.i8 I7, -1
    ASSERT_EQ I7, 8
    clz.u32 I7, 1
    ASSERT_EQ I7, 31
    clz.u64 I7, 0
    ASSERT_EQ I7, 64
    ctz.u16 I7, 0x100
    ASSERT_EQ I7, 8
    ctz.i32 I7, 0
    ASSERT_EQ I7, 32
    bswap.u32 I8, 0x11223344
    ASSERT_EQ I8, 0x44332211
    bswap.u16 I8, 0x1234
    ASSERT_EQ I8, 0x3412
    ret 0
.endf
