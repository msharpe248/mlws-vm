; Grapheme cluster and word boundaries (UAX #29) against the Unicode
; Consortium's own tests, GraphemeBreakTest.txt and WordBreakTest.txt: every
; case. Each is a string of code points and the boundaries inside it; the
; string's segments (text.graphemes, text.word_segments) must end exactly
; there. The cases come from tests/text/_unicode/break_data.inc, generated by
; build-tools/gen_unicode.py: "code points in hex;boundaries", the boundaries
; as code point indices.
.include "std/test.inc"
.include "_unicode/break_data.inc"

; The string for "0061 0308": the code points, as UTF-8.
.func from_hex(ref field) -> ref
    ncall "text.split" (field, " ") -> (R1)
    len I1, R1
    lnew R2, I1
    mov I0, 0
1:  bge I0, I1, 2f
    mov R3, R1[I0]
    strcat R4, "0x", R3
    parse.i64 I2, R4
    lpush.c R2, I2
    inc I0
    jmp 1b
2:  ncall "text.from_chars" (R2) -> (R5)
    ret R5
.endf

; The boundaries inside a string that segments make: "1 3", as the code point
; index where each segment but the last ends.
.func bounds(ref segs) -> ref
    len I1, segs
    lnew R1
    mov I0, 0
    mov I2, 0                            ; code points so far
    sub I1, 1                            ; the last segment ends the string
1:  bge I0, I1, 2f
    mov R2, segs[I0]
    ncall "text.length" (R2) -> (I3)
    add I2, I3
    lpush R1, I2
    inc I0
    jmp 1b
2:  ncall "text.join" (R1, " ") -> (R3)
    ret R3
.endf

; Runs every case of a list with the segmenting native `seg`.
.func run(ref cases, ref seg, ref what)
    len I1, cases
    ASSERT_GT I1, 500
    mov I0, 0
1:  bge I0, I1, 3f
    mov R11, cases[I0]                   ; "code points;boundaries"
    ncall "text.split" (R11, ";") -> (R12)
    mov R13, R12[0]
    call from_hex (R13) -> (R14)
    strcmp I2, seg, "grapheme"
    bnz I2, 4f
    ncall "text.graphemes" (R14) -> (R15)
    jmp 5f
4:  ncall "text.word_segments" (R14) -> (R15)
5:  call bounds (R15) -> (R16)
    mov R17, R12[1]
    strcmp I2, R16, R17
    bz I2, 2f
    lnew R18
    lpush R18, what, R11, R16
    ncall "text.format" ("{} boundaries for {}: got {}", R18) -> (R19)
    ncall "test.fail" (R19)
2:  inc I0
    jmp 1b
3:  ret
.endf

; text.next_grapheme walks the same clusters as text.graphemes.
.func walk(ref s) -> i64
    mov I0, 0                            ; offset
    mov I1, 0                            ; clusters
1:  ncall "text.next_grapheme" (s, I0) -> (I2)
    blt I2, 0, 2f
    mov I0, I2
    inc I1
    jmp 1b
2:  ret I1
.endf

.func main
    GRAPHEME_CASES R0
    call run (R0, "grapheme", "grapheme")
    WORD_CASES R1
    call run (R1, "word", "word")

    ; iterating by offset gives the same clusters (a family emoji, a flag
    ; pair, e and a combining acute, a Hangul syllable from its jamo)
    mov.r R2, "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{1F1EF}\u{1F1F5}e\u{301}\u{1100}\u{1161}\u{11A8}!"
    ncall "text.graphemes" (R2) -> (R3)
    len I0, R3
    ASSERT_EQ I0, 5
    call walk (R2) -> (I1)
    ASSERT_EQ I1, 5
    ret 0
.endf
