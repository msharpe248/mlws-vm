; Unicode normalization against the Unicode Consortium's own test,
; NormalizationTest.txt (every case of its parts 0, 2 and 3, and one in 25 of
; part 1, which tests each character alone). Each case has five strings, c1
; to c5, and these must hold:
;
;   c2 == NFC(c1) == NFC(c2) == NFC(c3)      c4 == NFC(c4) == NFC(c5)
;   c3 == NFD(c1) == NFD(c2) == NFD(c3)      c5 == NFD(c4) == NFD(c5)
;   c4 == NFKC(c1) == ... == NFKC(c5)        c5 == NFKD(c1) == ... == NFKD(c5)
;
; The cases come from tests/text/_unicode/norm_data.inc, generated by
; build-tools/gen_unicode.py: one string per case, the five fields separated
; by ';', each a list of code points in hex.
.include "std/test.inc"
.include "_unicode/norm_data.inc"

; The string for "1E0A 0323": the code points, as UTF-8.
.func from_hex(ref field) -> ref
    ncall "text.split" (field, " ") -> (R1)
    len I1, R1
    lnew R2, I1
    mov I0, 0
1:  bge I0, I1, 2f
    mov R3, R1[I0]
    strcat R4, "0x", R3
    parse.i64 I2, R4
    lpush.c R2, I2
    inc I0
    jmp 1b
2:  ncall "text.from_chars" (R2) -> (R5)
    ret R5
.endf

; Fails unless form(src) is want.
.func check(ref src, ref form, ref want, ref case)
    ncall "text.normalize" (src, form) -> (R4)
    strcmp I0, R4, want
    bz I0, 1f
    lnew R5
    lpush R5, form, case
    ncall "text.format" ("{} is wrong for case {}", R5) -> (R6)
    ncall "test.fail" (R6)
1:  ret
.endf

; The invariants for one case. R10..R14 are c1..c5.
.func one(ref line)
    ncall "text.split" (line, ";") -> (R1)
    .alias c1, R10
    .alias c2, R11
    .alias c3, R12
    .alias c4, R13
    .alias c5, R14
    mov R2, R1[0]
    call from_hex (R2) -> (c1)
    mov R2, R1[1]
    call from_hex (R2) -> (c2)
    mov R2, R1[2]
    call from_hex (R2) -> (c3)
    mov R2, R1[3]
    call from_hex (R2) -> (c4)
    mov R2, R1[4]
    call from_hex (R2) -> (c5)
    mov.r R20, "NFC"
    mov.r R21, "NFD"
    mov.r R22, "NFKC"
    mov.r R23, "NFKD"
    call check (c1, R20, c2, line)
    call check (c2, R20, c2, line)
    call check (c3, R20, c2, line)
    call check (c4, R20, c4, line)
    call check (c5, R20, c4, line)
    call check (c1, R21, c3, line)
    call check (c2, R21, c3, line)
    call check (c3, R21, c3, line)
    call check (c4, R21, c5, line)
    call check (c5, R21, c5, line)
    call check (c1, R22, c4, line)
    call check (c2, R22, c4, line)
    call check (c3, R22, c4, line)
    call check (c4, R22, c4, line)
    call check (c5, R22, c4, line)
    call check (c1, R23, c5, line)
    call check (c2, R23, c5, line)
    call check (c3, R23, c5, line)
    call check (c4, R23, c5, line)
    call check (c5, R23, c5, line)
    ; is_normalized agrees: c2 is NFC, c3 NFD, c4 NFKC, c5 NFKD
    ncall "text.is_normalized" (c2, R20) -> (I0)
    ASSERT_TRUE I0
    ncall "text.is_normalized" (c3, R21) -> (I0)
    ASSERT_TRUE I0
    ncall "text.is_normalized" (c4, R22) -> (I0)
    ASSERT_TRUE I0
    ncall "text.is_normalized" (c5, R23) -> (I0)
    ASSERT_TRUE I0
    ret
.endf

.func main
    NORM_CASES R0
    len I1, R0
    ASSERT_GT I1, 3000
    mov I0, 0
1:  bge I0, I1, 2f
    mov R1, R0[I0]
    call one (R1)
    inc I0
    jmp 1b
2:  ret 0
.endf
