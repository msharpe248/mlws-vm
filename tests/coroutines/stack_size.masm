; conew's optional third operand sets the coroutine's data-stack size in
; words. Overflowing it is an ordinary E_STACK_OVERFLOW inside the coroutine,
; which here goes out to the resumer.
; expect-stdout: E_STACK_OVERFLOW
.include "std/test.inc"
.include "std/io.inc"

.func pusher -> i64
    mov I0, 0
1:  push I0
    inc I0
    blt I0, 100, 1b
    ret I0
.endf

.func main
    closure pusher -> (R0)
    conew R1, R0, 200                    ; room for 100 pushes
    coresume R1 -> (I0)
    ASSERT_EQ I0, 100
    conew R1, R0, 64                     ; not enough
.try 1f
    coresume R1 -> (I0)
.endtry
1:  catch R2
    PRINTLN_S R2->Error.code
.try 2f
    conew R1, R0, 8                      ; below the minimum of 16
.endtry
2:  catch R2
    strcmp I1, R2->Error.code, "E_BAD_ALLOC"
    ASSERT_EQ I1, 0
    ret 0
.endf
