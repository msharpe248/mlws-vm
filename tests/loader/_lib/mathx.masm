; Helper library for the loader tests. The `.module` name matches the path
; relative to a library directory (_lib/mathx.masm -> _lib.mathx).
.module _lib.mathx
.export add3, triple, scale

scale:  .i64 3

.func add3(i64 a, i64 b, i64 c) -> i64
    add I3, a, b, c
    ret I3
.endf

.func triple(i64 v) -> i64
    mul v, @scale
    ret v
.endf

.func hidden                   ; not exported
    ret
.endf
