; Processes on every worker thread call a module in a loop while main replaces
; it twenty times, and frees what old versions it can after each (module.purge).
; Each sees its versions in order and none other, with calls hot enough to be
; compiled, and all reach the last one. Once they have ended, every old version
; has been freed.
.include "std/test.inc"
.import _reload.count as c

.const LAST = 20

.func caller(i64 parent)
    mov I1, 0                          ; the last version seen
    mov I2, 0                          ; calls
1:  call c.version -> (I3)
    ASSERT_GE I3, I1
    ASSERT_LE I3, LAST
    mov I1, I3
    inc I2
    blt I3, LAST, 1b
    send parent, I2
    ret
.endf

.func main
    mov I6, 0
    mov I0, 0
1:  spawn caller (PID)
    inc I0
    blt I0, 8, 1b
    mov I1, 2                          ; the next version
2:  tostr R0, I1
    strcat R1, ".export version\n.func version -> i64\n    ret ", R0, "\n.endf\n"
    ncall "module.reload_text" ("_reload.count", R1)
    call c.version -> (I2)
    ASSERT_EQ I2, I1
    ncall "module.purge" ("_reload.count") -> (I4, I5)
    add I6, I4                          ; freed so far
    inc I1
    ble I1, LAST, 2b
    mov I0, 0
3:  recv I3
    ASSERT_GT I3, 0
    inc I0
    blt I0, 8, 3b
    ncall "module.purge" ("_reload.count") -> (I4, I5)
    ASSERT_EQ I5, 0                     ; nothing runs them now
    add I6, I4
    ASSERT_EQ I6, 19                    ; versions 1 to 19
    ret 0
.endf
