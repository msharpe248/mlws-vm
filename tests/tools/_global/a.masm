; Names across the cluster (check_tools.sh, with b.masm): node a registers a
; name; b sees it, and cannot take it; when a's process ends, the name goes
; everywhere; when the nodes part, each drops the other's names; and when
; both registered one name apart, they settle it on meeting again: the lower
; pid keeps it at both, and b's process is killed.
.include "std/test.inc"
.import std.node as node

.func idle
1:  recv R0
    jmp 1b
.endf

; Ask b's agent.
.func ask(ref body) -> ref
    ncall "node.name_pid" (2, "agent") -> (I1)
    ncall "proc.call" (I1, body, 10000) -> (R1)
    ret R1
.endf

.func b_whereis(ref name) -> i64
    lnew R1
    lpush R1, "whereis", name
    call ask (R1) -> (R2)
    mov I1, R2[0]
    ret I1
.endf

.func main
    ncall "os.args" () -> (R0)
    mov R1, R0[0]
    parse.i64 I1, R1
    call node.start (1, "global", 0) -> (I2)
    call node.connect ("127.0.0.1", I1, "global") -> (I3)
    ASSERT_EQ I3, 2

    ; Registered here, seen there; taken.
    spawn idle -> (I10)
    call node.self (I10) -> (I11)
    call node.register_global ("svc", I10) -> (I4)
    ASSERT_EQ I4, 1
    call node.whereis_global ("svc") -> (I5)
    ASSERT_EQ I5, I11
    call b_whereis ("svc") -> (I5)
    ASSERT_EQ I5, I11
    lnew R2
    lpush R2, "register", "svc"
    call ask (R2) -> (R3)
    mov I6, R3[0]
    ASSERT_EQ I6, 0                    ; (taken)
    call node.register_global ("svc", I10) -> (I4)
    ASSERT_EQ I4, 1                    ; (again, by the same process: yes)
    call node.globals () -> (R4)
    len I7, R4
    ASSERT_EQ I7, 1

    ; Its process ends: the name goes, everywhere.
    monitor I10
    kill I10
    recv R5
    sleep 100
    call node.whereis_global ("svc") -> (I5)
    ASSERT_EQ I5, 0
    call b_whereis ("svc") -> (I5)
    ASSERT_EQ I5, 0

    ; Unregistered: gone everywhere.
    spawn idle -> (I12)
    call node.register_global ("svc", I12) -> (I4)
    ASSERT_EQ I4, 1
    call node.unregister_global ("svc")
    call b_whereis ("svc") -> (I5)
    ASSERT_EQ I5, 0

    ; Apart: each drops the other's names, and both register "both".
    call node.self (I12) -> (I13)
    call node.register_global ("mine", I12) -> (I4)
    ASSERT_EQ I4, 1
    call node.watch ()
    call node.disconnect (2)
    recv R6                            ; (the NodeEvent: down)
    call node.whereis_global ("mine") -> (I5)
    ASSERT_EQ I5, I13                  ; (a's own: kept)
    call node.register_global ("both", I12) -> (I4)
    ASSERT_EQ I4, 1                    ; (alone)
    sleep 300                          ; (b registers "both" too, alone)

    ; Again together (a message connects: M101): the names are swapped, and
    ; "both" stays with a's process, the lower pid, at both; b kills its own.
    lnew R2
    lpush R2, "local", "both ok"
    call ask (R2) -> (R3)
    mov I14, R3[0]
    ASSERT_NE I14, 0                   ; (b registered "both" while apart)
    recv R6                            ; (the NodeEvent: up)
    sleep 300                          ; (the names swapped)
    call b_whereis ("mine") -> (I5)
    ASSERT_EQ I5, I13
    call b_whereis ("both") -> (I5)
    ASSERT_EQ I5, I13
    call node.whereis_global ("both") -> (I5)
    ASSERT_EQ I5, I13
    lnew R2
    lpush R2, "local", "both holder"
    call ask (R2) -> (R3)
    mov I14, R3[0]
    ASSERT_EQ I14, 0                   ; (killed: its local name went with it)
    ret 0
.endf
