; A third VM that check_tools.sh runs against node 2 (on the port in its first
; argument, plainly) before node 1 does: it takes node 2's own name, so each
; end refuses the connection (E_NODE), and node 2 is as it was for node 1.
.include "std/test.inc"
.import std.node as node

.func main
    ncall "os.args" () -> (R0)
    mov R1, R0[0]
    parse.i64 I0, R1
    call node.set_name ("two@test")
    call node.start (3, "the cookie", 0) -> (I1)
.try refused
    call node.connect ("127.0.0.1", I0, "the cookie") -> (I2)
.endtry
    FAIL "connected with another node's name"
refused:
    catch R2
    mov R3, R2->Error.code
    strcmp I3, R3, "E_NODE"
    ASSERT_EQ I3, 0
    mov R4, R2->Error.message
    ncall "text.find" (R4, "name, two@test,", 0) -> (I4)
    ASSERT_GE I4, 0
    call node.connected (2) -> (I5)
    ASSERT_FALSE I5
    ret 0
.endf
