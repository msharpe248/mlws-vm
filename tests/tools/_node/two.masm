; Node 2 of the pair check_tools.sh starts: registered processes that double
; numbers (by message) and triple them (by proc.call), and one that ends this
; VM when told. It prints the port it took.
; With the argument "tls", it takes only TLS.
.import std.node as node
.import worker
.func doubler
    ncall "proc.register" ("doubler", PID)
1:  recv R0
    mov I1, R0[0]
    mov I2, R0[1]
    mul I3, I2, 2
    send I1, I3
    jmp 1b
.endf
.func tripler
    ncall "proc.register" ("tripler", PID)
1:  recv R0                            ; a Call{from, id, body}, from another node
    mov R1, R0->Call.body
    mov I1, R1[0]
    mul I1, I1, 3
    lnew R2
    lpush R2, I1
    ncall "proc.reply" (R0, R2)
    jmp 1b
.endf
; Answers a call with the name node 1 gave, and the number of that name.
.func namer
    ncall "proc.register" ("namer", PID)
1:  recv R0
    call node.name (1) -> (R1)
    call node.number (R1) -> (I1)
    lnew R2
    lpush R2, R1
    lpush R2, I1
    ncall "proc.reply" (R0, R2)
    jmp 1b
.endf
.func stopper
    ncall "proc.register" ("stopper", PID)
    recv I0
    ncall "os.exit" (0)
    ret
.endf
.func main
    call node.set_name ("two@test")
    ncall "os.args" () -> (R0)
    len I0, R0
    bz I0, 2f
    call node.start_tls (2, "the cookie", 0, "tests/net/_tls/cert.pem", "tests/net/_tls/key.pem") -> (I1)
    jmp 3f
2:  call node.start (2, "the cookie", 0) -> (I1)
3:
    spawn doubler
    spawn tripler
    spawn namer
    spawn stopper
    sleep 100                          ; (all registered by now)
    ncall "io.print_i" (I1)
    ncall "io.nl" ()
    ncall "io.flush" ()
1:  sleep 1000
    jmp 1b
.endf
