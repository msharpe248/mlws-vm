; Node 1 of the pair check_tools.sh starts: everything std.node does, against
; node 2 on the port in its first argument, over TLS if the second is "tls"
; (and then a plain connection must be refused). Exits 0 if all is well.
.include "std/test.inc"
.import std.node as node

tls:    .i64 0                       ; 1: node 2 takes only TLS

; Connect, as node 2 wants.
.func open(i64 port, ref cookie) -> i64
    bz @tls, 1f
    call node.connect_tls ("localhost", port, cookie, "tests/net/_tls/cert.pem") -> (I2)
    ret I2
1:  call node.connect ("127.0.0.1", port, cookie) -> (I2)
    ret I2
.endf

; What connecting with a cookie raises, or null.
.func connect_error(i64 port, ref cookie) -> ref
.try h
    call open (port, cookie) -> (I1)
.endtry
    ret null
h:
    catch R1
    mov R2, R1->Error.code
    ret R2
.endf

.struct Note
    text: ref
    n: i64
.ends

.func main
    ncall "os.args" () -> (R0)
    mov R1, R0[0]
    parse.i64 I0, R1
    len I30, R0
    blt I30, 2, 1f
    mov @tls, 1
1:
    call node.start (1, "the cookie", 0) -> (I1)
    ncall "node.self" () -> (I2)
    ASSERT_EQ I2, 1

    ; A wrong cookie gets nowhere.
    call connect_error (I0, "not the cookie") -> (R2)
    strcmp I3, R2, "E_NODE"
    ASSERT_EQ I3, 0
    call node.connected (2) -> (I20)
    ASSERT_FALSE I20

    ; Over TLS, a plain connection gets nowhere either.
    bz @tls, 2f
.try plain_refused
    call node.connect ("127.0.0.1", I0, "the cookie") -> (I29)
.endtry
    FAIL "a plain connection to a TLS node"
plain_refused:
    catch R29
2:
    ; The right one does.
    call open (I0, "the cookie") -> (I4)
    ASSERT_EQ I4, 2
    call node.connected (2) -> (I20)
    ASSERT_TRUE I20

    ; A registered process there, and a message there and back.
    call node.whereis (2, "doubler") -> (I5)
    ASSERT_NE I5, 0
    call node.node_of (I5) -> (I6)
    ASSERT_EQ I6, 2
    call node.whereis (2, "nobody") -> (I6)
    ASSERT_EQ I6, 0
    call node.self (PID) -> (I7)
    call node.node_of (I7) -> (I8)
    ASSERT_EQ I8, 1
    lnew R3
    lpush R3, I7
    lpush R3, 21
    send I5, R3
    recv I9
    ASSERT_EQ I9, 42

    ; A spawn there, with what a message can carry; and being told it ended.
    lnew R4
    lpush R4, I7
    call node.spawn (2, "worker", "serve", R4) -> (I10)
    ASSERT_NE I10, 0
    call node.monitor (I10)
    bufnew R5, 0
    strcat R6, "over ", "the wire"
    send I10, R6
    recv R7
    strcmp I11, R7, "got over the wire"
    ASSERT_EQ I11, 0
    recv R8
    mov R9, R8[0]
    strcmp I11, R9, "down"
    ASSERT_EQ I11, 0
    mov I12, R8[1]
    ASSERT_EQ I12, I10
    mov R10, R8[2]
    ASSERT_FALSE R10, r

    ; A function that does not exist there: no pid.
    call node.spawn (2, "worker", "nothing", R4) -> (I13)
    ASSERT_EQ I13, 0

    ; The node goes: a watcher hears, and a send goes nowhere.
    call node.monitor (I5)
    call node.whereis (2, "stopper") -> (I14)
    send I14, 1
    recv R11
    mov R12, R11[2]
    strcmp I15, R12, "E_NODE_DOWN"
    ASSERT_EQ I15, 0
    send I5, R3
    ret 0
.endf
