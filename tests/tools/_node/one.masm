; Node 1 of the pair check_tools.sh starts: everything std.node does, against
; node 2 on the port in its first argument, over TLS if the second is "tls"
; (and then a plain connection must be refused). Exits 0 if all is well.
.include "std/test.inc"
.import std.node as node
.import worker                         ; (also node 2's: the same code, so its closures cross)

tls:    .i64 0                       ; 1: node 2 takes only TLS
w1: .i64 0                              ; the watchers
w2: .i64 0

; Connect, as node 2 wants.
.func open(i64 port, ref cookie) -> i64
    bz @tls, 1f
    call node.connect_tls ("localhost", port, cookie, "tests/net/_tls/cert.pem") -> (I2)
    ret I2
1:  call node.connect ("127.0.0.1", port, cookie) -> (I2)
    ret I2
.endf

; What connecting with a cookie raises, or null.
.func connect_error(i64 port, ref cookie) -> ref
.try h
    call open (port, cookie) -> (I1)
.endtry
    ret null
h:
    catch R1
    mov R2, R1->Error.code
    ret R2
.endf

.struct Note
    text: ref
    n: i64
.ends

.func main
    ncall "os.args" () -> (R0)
    mov R1, R0[0]
    parse.i64 I0, R1
    len I30, R0
    blt I30, 2, 1f
    mov @tls, 1
1:
    call node.name (0) -> (R25)
    strcmp I3, R25, ""                 ; no name yet
    ASSERT_EQ I3, 0
    call node.set_name ("one@test")
    call node.set_name ("one@test")    ; (again, the same: nothing)
.try renamed
    call node.set_name ("other@test")
.endtry
    FAIL "a second name"
renamed:
    catch R25
    call node.start (1, "the cookie", 0) -> (I1)
    spawn watcher (2) -> (I3)          ; NodeEvents, from before connecting
    mov @w1, I3
    spawn watcher (0) -> (I3)          ; one that stops watching: none
    mov @w2, I3
    sleep 50                           ; (both watching, the second no longer)
    ncall "node.self" () -> (I2)
    ASSERT_EQ I2, 1

    ; A wrong cookie gets nowhere.
    call connect_error (I0, "not the cookie") -> (R2)
    strcmp I3, R2, "E_NODE"
    ASSERT_EQ I3, 0
    call node.connected (2) -> (I20)
    ASSERT_FALSE I20

    ; Over TLS, a plain connection gets nowhere either.
    bz @tls, 2f
.try plain_refused
    call node.connect ("127.0.0.1", I0, "the cookie") -> (I29)
.endtry
    FAIL "a plain connection to a TLS node"
plain_refused:
    catch R29
2:
    ; The right one does.
    call open (I0, "the cookie") -> (I4)
    ASSERT_EQ I4, 2
    call node.connected (2) -> (I20)
    ASSERT_TRUE I20

    ; Names, each way: node 2's here, and this one's there.
    call node.name (2) -> (R25)
    strcmp I3, R25, "two@test"
    ASSERT_EQ I3, 0
    call node.number ("two@test") -> (I3)
    ASSERT_EQ I3, 2
    call node.number ("one@test") -> (I3)
    ASSERT_EQ I3, 1
    call node.name (1) -> (R25)
    strcmp I3, R25, "one@test"
    ASSERT_EQ I3, 0
    call node.number ("nobody@test") -> (I3)
    ASSERT_EQ I3, 0
    call node.name (3) -> (R25)
    strcmp I3, R25, ""
    ASSERT_EQ I3, 0
    call node.nodes () -> (R25)
    len I3, R25
    ASSERT_EQ I3, 1
    mov I3, R25[0]
    ASSERT_EQ I3, 2
    call node.whereis (2, "namer") -> (I3)
    ncall "proc.call" (I3, 0, 5000) -> (R25)
    mov R26, R25[0]
    strcmp I3, R26, "one@test"
    ASSERT_EQ I3, 0
    mov I3, R25[1]
    ASSERT_EQ I3, 1

    ; Closures cross: one of worker's (loaded there too), not exported and with
    ; a captured value, runs there; a handle there calls node 2's twice; one of
    ; this module's, which node 2 does not have, raises E_LINK_CODE there, and
    ; comes back as itself. A struct node 2 has not is dropped there, and the
    ; connection goes on.
    call node.whereis (2, "applier") -> (I3)
    call worker.make_adder (5) -> (R26)
    call apply_there (I3, R26, 10) -> (R27)
    mov I4, R27[0]
    ASSERT_EQ I4, 15
    ncall "module.handle" ("worker", "twice") -> (R26)
    call apply_there (I3, R26, 21) -> (R27)
    mov I4, R27[0]
    ASSERT_EQ I4, 42
    closure here_only (7) -> R26
    call apply_there (I3, R26, 1) -> (R27)
    mov R28, R27[1]
    strcmp I4, R28, "E_LINK_CODE"
    ASSERT_EQ I4, 0
    call node.whereis (2, "echoer") -> (I4)
    ncall "proc.call" (I4, R26, 5000) -> (R27)
    calli R27 (1) -> (I5)              ; back here: the closure it was
    ASSERT_EQ I5, 8
    new R28, Note
    send I4, R28                       ; (dropped there: no struct one.Note)
    ncall "proc.call" (I4, "still there", 5000) -> (R27)
    ASSERT_TRUE R27, r                 ; (a call after it: still connected)

    ; A registered process there, and a message there and back.
    call node.whereis (2, "doubler") -> (I5)
    ASSERT_NE I5, 0
    call node.node_of (I5) -> (I6)
    ASSERT_EQ I6, 2
    call node.whereis (2, "nobody") -> (I6)
    ASSERT_EQ I6, 0
    call node.self (PID) -> (I7)
    call node.node_of (I7) -> (I8)
    ASSERT_EQ I8, 1
    lnew R3
    lpush R3, I7
    lpush R3, 21
    send I5, R3
    recv I9
    ASSERT_EQ I9, 42

    ; A spawn there, with what a message can carry; and a Down when it ends.
    lnew R4
    lpush R4, I7
    call node.spawn (2, "worker", "serve", R4) -> (I10)
    ASSERT_NE I10, 0
    monitor I10
    strcat R6, "over ", "the wire"
    send I10, R6
    recv R7
    strcmp I11, R7, "got over the wire"
    ASSERT_EQ I11, 0
    recv R8
    mov I12, R8->Down.pid
    ASSERT_EQ I12, I10
    mov R10, R8->Down.code
    ASSERT_FALSE R10, r                ; a normal end

    ; A function that does not exist there: no pid.
    call node.spawn (2, "worker", "nothing", R4) -> (I13)
    ASSERT_EQ I13, 0

    ; proc.call there: an answer, no such process, no answer in time, and a
    ; node that is not connected.
    call node.whereis (2, "tripler") -> (I14)
    lnew R11
    lpush R11, 7
    ncall "proc.call" (I14, R11, 5000) -> (R12)
    mov I15, R12[0]
    ASSERT_EQ I15, 21
    or I16, I14, 0xFFFFF               ; (a pid nobody has there)
    call call_code (PID, I16, 5000)
    recv R13
    call expect (R13, "E_NOPROC")
    call node.spawn (2, "worker", "ignore", R4) -> (I17)
    call call_code (PID, I17, 200)
    recv R13
    call expect (R13, "E_TIMEOUT")
    mov I18, 99
    shl I18, I18, 48
    or I18, I18, 5                     ; process 5 of node 99, which is not connected
    call call_code (PID, I18, 5000)
    recv R13
    call expect (R13, "E_NODE_DOWN")

    ; monitor: no such process there, and a node that is not connected.
    monitor I16
    recv R14
    mov R15, R14->Down.code
    call expect (R15, "E_NOPROC")
    monitor I18
    recv R14
    mov R15, R14->Down.code
    call expect (R15, "E_NODE_DOWN")

    ; link, one way: a process there fails, and the one here linked to it goes too.
    call node.spawn (2, "worker", "fail_on_msg", R4) -> (I20)
    spawnm link_wait (PID, I20) -> (I21)
    recv I22                           ; linked
    send I20, "go"
    call down_code (I21) -> (R16)
    call expect (R16, "E_LINKED")
    ; the other way: one here fails, and the one there goes too.
    call node.spawn (2, "worker", "ignore", R4) -> (I23)
    monitor I23
    spawn link_fail (I23)
    call down_code (I23) -> (R16)
    call expect (R16, "E_LINKED")
    ; a normal end only unlinks, either way.
    call node.spawn (2, "worker", "wait_one", R4) -> (I24)
    monitor I24
    spawnm link_end (PID, I24) -> (I25)
    recv I22
    call down_code (I25) -> (R16)
    ASSERT_FALSE R16, r
    sleep 100                          ; (the unlink there before the message)
    send I24, "go"                        ; still alive: it ends normally
    call down_code (I24) -> (R16)
    ASSERT_FALSE R16, r
    call node.spawn (2, "worker", "wait_one", R4) -> (I26)
    monitor I26
    spawnm link_wait (PID, I26) -> (I27)
    recv I22
    send I26, "go"
    call down_code (I26) -> (R16)
    ASSERT_FALSE R16, r
    sleep 100
    send I27, "go"                        ; still alive too
    call down_code (I27) -> (R16)
    ASSERT_FALSE R16, r
    ; a link to no such process there, or to a node that is not connected.
    spawnm link_hold (I16) -> (I28)
    call down_code (I28) -> (R16)
    call expect (R16, "E_LINKED")
.try not_connected
    link I18
.endtry
    FAIL "linked to a node that is not connected"
not_connected:
    catch R17
    mov R18, R17->Error.code
    call expect (R18, "E_NODE_DOWN")

    ; kill there: the process is killed, and its watcher here hears E_KILLED;
    ; a kill of one not there, or on a node not connected, does nothing.
    call node.spawn (2, "worker", "ignore", R4) -> (I23)
    monitor I23
    kill I23
    call down_code (I23) -> (R16)
    call expect (R16, "E_KILLED")
    kill I16
    kill I18
    alive I22, I23
    ASSERT_FALSE I22                   ; (alive: this VM's pids only)

    ; The node goes: a watcher hears, a linked process goes, a call waiting
    ; for an answer fails, and a send goes nowhere.
    monitor I5
    call node.spawn (2, "worker", "ignore", R4) -> (I30)
    monitor I30
    spawnm link_wait (PID, I30) -> (I31)
    recv I22
    spawn call_code (PID, I30, 20000)
    sleep 100                          ; (the call there)
    call node.whereis (2, "stopper") -> (I19)
    send I19, 1
    mov I1, 0                          ; what has come: 1 Down of I5, 2 of I30, 4 of I31, 8 the call
1:  recv R19
    isa I2, R19, Down
    bz I2, 3f
    mov I3, R19->Down.pid
    mov R20, R19->Down.code
    beq I3, I31, 2f
    call expect (R20, "E_NODE_DOWN")
    mov I4, 1
    beq I3, I5, 4f
    ASSERT_EQ I3, I30
    mov I4, 2
    jmp 4f
2:  call expect (R20, "E_LINKED")
    mov I4, 4
    jmp 4f
3:  call expect (R19, "E_NODE_DOWN")
    mov I4, 8
4:  and I6, I1, I4
    ASSERT_EQ I6, 0                   ; (each once)
    or I1, I1, I4
    bne I1, 15, 1b
    send I5, R3
    ; The watchers saw node 2 come and go.
    mov I3, @w1
    send I3, PID
    recv R25
    len I3, R25
    ASSERT_EQ I3, 2
    mov R26, R25[0]
    call event_is (R26, 1)
    mov R26, R25[1]
    call event_is (R26, 0)
    mov I3, @w2
    send I3, PID
    recv R25
    len I3, R25
    ASSERT_EQ I3, 0
    ; Gone, but its name still known; no node connected.
    call node.name (2) -> (R25)
    strcmp I3, R25, "two@test"
    ASSERT_EQ I3, 0
    call node.number ("two@test") -> (I3)
    ASSERT_EQ I3, 2
    call node.nodes () -> (R25)
    len I3, R25
    ASSERT_EQ I3, 0
    ret 0
.endf

; Fail if a value is not this error code: a code, or a list [_, code].
.func expect(ref got, ref code)
    typeof I0, got
    bne I0, 5, 1f                      ; (5: a list)
    mov R0, got[1]
    jmp 2f
1:  mov R0, got
2:  bz R0, 3f
    strcmp I1, R0, code
    bnz I1, 3f
    ret
3:  FAIL "not the error expected"
    ret
.endf

; The code of a Down of pid (null for a normal end), waiting for it.
.func down_code(i64 pid) -> ref
    recv R0
    isa I2, R0, Down
    ASSERT_TRUE I2
    mov I1, R0->Down.pid
    ASSERT_EQ I1, pid
    mov R1, R0->Down.code
    ret R1
.endf

; proc.call pid, and send parent what came: ["answer", reply] or ["error", code].
.func call_code(i64 parent, i64 pid, i64 ms)
    lnew R0
    lpush R0, 1
.try h
    ncall "proc.call" (pid, R0, ms) -> (R1)
.endtry
    lnew R2
    lpush R2, "answer"
    lpush R2, R1
    send parent, R2
    ret
h:  catch R3
    mov R4, R3->Error.code
    lnew R2
    lpush R2, "error"
    lpush R2, R4
    send parent, R2
    ret
.endf

; Link to pid, say so, then end normally at the first message.
.func link_wait(i64 parent, i64 pid)
    link pid
    send parent, 1
    recv R0
    ret
.endf

; Link to pid, and wait.
.func link_hold(i64 pid)
    link pid
    recv R0
    ret
.endf

; Link to pid, say so, and end normally.
.func link_end(i64 parent, i64 pid)
    link pid
    send parent, 1
    ret
.endf

; Link to pid, then fail.
.func link_fail(i64 pid)
    link pid
    new R0, Error
    mov R0->Error.code, "E_TOLD"
    mov R0->Error.message, "told to fail"
    throw R0
.endf

; Watch nodes (and, if n is 0, stop at once), keep the first n NodeEvents, and
; send them as a list to the pid that asks.
.func watcher(i64 n)
    call node.watch ()
    bnz n, 1f
    call node.unwatch ()
1:  lnew R0
3:  len I1, R0
    bge I1, n, 2f
    recv R1
    isa I2, R1, NodeEvent
    ASSERT_TRUE I2
    lpush R0, R1
    jmp 3b
2:  recv I3
    send I3, R0
    ret
.endf

; Fail unless e is a NodeEvent of node 2, two@test, coming (up 1) or going.
.func event_is(ref e, i64 up)
    mov I3, e->NodeEvent.node
    ASSERT_EQ I3, 2
    mov R1, e->NodeEvent.name
    strcmp I4, R1, "two@test"
    ASSERT_EQ I4, 0
    mov I5, e->NodeEvent.up
    ASSERT_EQ I5, up
    ret
.endf

; Call there [f, x], and return the answer: [result] or [null, code].
.func apply_there(i64 to, ref f, i64 x) -> ref
    lnew R1
    lpush R1, f, x
    ncall "proc.call" (to, R1, 5000) -> (R2)
    ret R2
.endf

; Adds UP[0]: a closure of a module only this node has.
.func here_only(i64 x) -> i64
    mov I1, UP[0]
    add I0, x, I1
    ret I0
.endf
