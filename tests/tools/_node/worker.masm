; Spawned on another node by tests/tools/_node/one.masm.
.export serve, wait_one, ignore, fail_on_msg, make_adder, twice

; Answers once.
.func serve(ref who)
    mov I0, who[0]
    recv R1
    strcat R2, "got ", R1
    send I0, R2
    ret
.endf

; Ends normally at its first message.
.func wait_one(ref who)
    recv R1
    ret
.endf

; Never answers, never ends.
.func ignore(ref who)
1:  recv R1
    jmp 1b
.endf

; Fails at its first message.
.func fail_on_msg(ref who)
    recv R1
    new R2, Error
    mov R2->Error.code, "E_TOLD"
    mov R2->Error.message, "told to fail"
    throw R2
.endf

; A closure of a function that is not exported, with n captured: adds n.
.func make_adder(i64 n) -> ref
    closure add_n (n) -> R0
    ret R0
.endf
.func add_n(i64 x) -> i64
    mov I1, UP[0]
    add I0, x, I1
    ret I0
.endf

.func twice(i64 x) -> i64
    add I0, x, x
    ret I0
.endf
