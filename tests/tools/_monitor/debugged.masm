; Debugged by check_tools.sh through the monitor's /api/debug, a process at a
; time, while the rest runs: `worker` counts in a loop, calling `bump` and
; keeping what it returns in a struct and a list; `other` counts beside it and
; is never debugged, so the test can see it go on while `worker` is paused;
; `breaker` waits for a message and then meets a `break` instruction, which
; stops a debugged process and no other. A variable of two registers is shown
; by the module's formatter. It runs for a minute at most; the test stops it.
.debug_format show
.struct Seen
    count: i64
    last: ref
.ends

; (I, R): R null: an integer, in I; else R is the value.
.func show(i64 i, ref r) -> ref
    bnz.r r, 1f
    tostr R1, i
    strcat R1, "int ", R1
    ret R1
1:  ret r
.endf

.func bump(i64 n) -> i64
    add I1, n, 1
    ret I1
.endf

.func worker
    ncall "proc.register" ("worker", PID)
    mov I5, 0
    .local count, I5
    new R1, Seen
    .local seen, R1
    lnew R2
    .local all, R2
    mov I3, 7
    mov.r R3, null
    .local tagged, I3, R3
1:  call bump (I5) -> (I5)
    mov R1->Seen.count, I5
    lpush R2, I5
    len I6, R2
    blt I6, 3, 2f
    lnew R2                            ; (three at most: a new list)
2:  sleep 5
    jmp 1b
.endf

.func other
    ncall "proc.register" ("other", PID)
    mov I0, 0
1:  add I0, I0, 1
    tostr R0, I0
    ncall "monitor.log" (1, R0)
    sleep 20
    jmp 1b
.endf

.func breaker
    ncall "proc.register" ("breaker", PID)
1:  recv R0
    break
    ncall "monitor.log" (1, "after the break")
    jmp 1b
.endf

.func main
    spawn worker -> (I0)
    spawn other -> (I1)
    spawn breaker -> (I2)
    sleep 60000
    ret 0
.endf
