; simplify: identities that hold whatever the other operand is (x + 0,
; x * 1, x - x, x ^ x, x & -1 ...), a multiply by a power of two as a
; shift, a compare with 0 as bz / bnz, and a constant put second where a
; compare or commutative arithmetic has it first (the quickener's fast forms
; take a constant second; a compare is mirrored: 1 < x is x > 1). Floats only
; where it is exact: x * 1.0 and x - 0.0, never x + 0.0 (-0.0 + 0.0 is +0.0).
; A constant is taken as the instruction's type reads it: mul.i8 x, 2^32 is
; x * 0, not x << 32 (which would shift by 32 mod 8 = 0), and mul.u8 x, 258
; is x * 2 (found by mlwsvm fuzz).
; The fourteen: five in ints, four in narrow, one in floats, two in
; compares, and main's two ASSERT_EQ of a value with 0, which compare with 0
; (bz).
; option: --opt simplify
; expect-opt: simplify 14
.include "std/test.inc"

.func ints(i64 x) -> i64
    add I1, x, 0                         ; mov I1, x
    mul I2, I1, 8                        ; shl I2, I1, 3
    sub I3, x, x                         ; mov I3, 0
    xor I4, x, x                         ; mov I4, 0
    and I5, I2, -1                       ; mov I5, I2
    add I6, I5, I3, I4                   ; (three sources: left alone)
    ret I6
.endf

.func narrow(i64 x) -> i64
    mul.i8 I1, x, 4294967296             ; 0 as an i8: mov.i8 I1, 0
    mul.i32 I2, x, 1099511627776         ; 2^40, 0 as an i32: mov.i32 I2, 0
    add.u8 I3, x, 256                    ; 0 as a u8: mov.u8 I3, x
    mul.u8 I4, x, 258                    ; 2 as a u8: shl.u8 I4, x, 1
    add I5, I1, I2, I3, I4
    ret I5
.endf

.func floats(f64 y) -> f64
    mul F1, y, 1.0                       ; mov F1, y
    add F2, F1, 0.0                      ; stays: not an identity for -0.0
    ret F2
.endf

.func compares(i64 x) -> i64
    beq x, 0, 1f                         ; bz x, 1f
    blt 1, x, 2f                         ; bgt x, 1, 2f
    ret 1
1:  ret 0
2:  ret 2
.endf

.func main
    call ints (5) -> (I0)
    ASSERT_EQ I0, 40
    call narrow (300) -> (I0)            ; 0 + 0 + 44 + 88 (300 is 44 as a u8)
    ASSERT_EQ I0, 132
    call floats (-0.0) -> (F0)
    bitcast.i64.f64 I0, F0
    ASSERT_EQ I0, 0                      ; +0.0: -0.0 + 0.0
    call compares (0) -> (I0)
    ASSERT_EQ I0, 0
    call compares (1) -> (I0)
    ASSERT_EQ I0, 1
    call compares (5) -> (I0)
    ASSERT_EQ I0, 2
    ret 0
.endf
