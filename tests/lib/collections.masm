; std.collections: list.sort (stable, with a comparator closure or in natural
; order), list.bsearch with a probe closure, and set operations on maps. The
; closures run during the native call, through the same re-entrant path as C
; callbacks: a comparator's uncaught exception is raised by list.sort.
; expect-stdout: 1 2 3 5 8 13
; expect-stdout: apple banana cherry
; expect-stdout: 13 8 5 3 2 1
; expect-stdout: b1 a1 a2 b2
.include "std/test.inc"
.include "std/io.inc"
.include "expect.inc"
.struct Item
    key: i64
    name: ref
.ends

.func print_list(ref l)
    len I0, l
    mov I1, 0
1:  bz I1, 2f
    PRINT_S " "
2:  tostr R1, R0[I1]
    PRINT_S R1
    inc I1
    blt I1, I0, 1b
    NL
    ret
.endf

.func descending(i64 a, i64 b) -> i64
    sub I2, b, a
    ret I2
.endf

.func by_key(ref a, ref b) -> i64
    sub I2, R0->Item.key, R1->Item.key
    ret I2
.endf

.func failing(i64 a, i64 b) -> i64
    throw "no order"
.endf

; probe for bsearch: where x is relative to UP[0]
.func probe(i64 x) -> i64
    sub I1, x, UP[0]
    ret I1
.endf

.func item(i64 k, ref n) -> ref
    new R2, Item
    mov R2->Item.key, k
    mov R2->Item.name, n
    ret R2
.endf

.func main
    lnew R0
    lpush R0, 5, 3, 13, 1, 8, 2
    ncall "list.sort" (R0, null)               ; natural order
    call print_list (R0)
    lnew R1
    lpush R1, "cherry", "apple", "banana"
    ncall "list.sort" (R1, null)
    call print_list (R1)
    closure descending () -> (R2)
    ncall "list.sort" (R0, R2)
    call print_list (R0)

    ; stable: equal keys keep their order
    lnew R3
    call item (2, "a2") -> (R4)
    lpush R3, R4
    call item (1, "b1") -> (R4)
    lpush R3, R4
    call item (2, "b2") -> (R4)
    lpush R3, R4
    call item (1, "a1") -> (R4)
    lpush R3, R4
    ; an equal-key pair in each order: sorting keeps b1 before a1, a2 before b2
    closure by_key () -> (R5)
    ncall "list.sort" (R3, R5)
    mov I0, 0
1:  mov R6, R3[I0]
    bz I0, 2f
    PRINT_S " "
2:  PRINT_S R6->Item.name
    inc I0
    blt I0, 4, 1b
    NL

    ; errors
    closure failing () -> (R7)
.try h
    ncall "list.sort" (R0, R7)
.endtry
    FAIL "the comparator's exception was lost"
h:  catch R8
    strcmp I1, R8, "no order"                  ; the comparator's own exception
    ASSERT_EQ I1, 0
    lnew R9
    lpush R9, 1, "one"
    EXPECT_ERROR "E_TYPE", ncall "list.sort" (R9, null)  ; numbers and strings do not compare
    EXPECT_ERROR "E_TYPE", ncall "list.sort" (R1, R2)    ; a comparator of integers, given strings

    ; binary search: found, and where it would go
    lnew R10
    lpush R10, 1, 3, 5, 7, 9
    closure probe (7) -> (R11)
    ncall "list.bsearch" (R10, R11) -> (I2)
    ASSERT_EQ I2, 3
    closure probe (4) -> (R11)
    ncall "list.bsearch" (R10, R11) -> (I2)
    ASSERT_EQ I2, -3                           ; -(2) - 1: it would go at index 2
    closure probe (10) -> (R11)
    ncall "list.bsearch" (R10, R11) -> (I2)
    ASSERT_EQ I2, -6

    ; maps as sets
    mnew R12
    mset R12, "a", 1
    mset R12, "b", 2
    mset R12, "c", 3
    mnew R13
    mset R13, "b", 20
    mset R13, "d", 40
    ncall "map.union" (R12, R13) -> (R14)
    len I3, R14
    ASSERT_EQ I3, 4
    mget I4, R14, "b"                          ; the second map's value wins
    ASSERT_EQ I4, 20
    ncall "map.intersect" (R12, R13) -> (R14)
    len I3, R14
    ASSERT_EQ I3, 1
    mget I4, R14, "b"                          ; the first map's value
    ASSERT_EQ I4, 2
    ncall "map.difference" (R12, R13) -> (R14)
    len I3, R14
    ASSERT_EQ I3, 2
    mhas I5, R14, "b"
    ASSERT_FALSE I5
    ret 0
.endf
