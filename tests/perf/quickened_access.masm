; The quickened forms for 64-bit globals, elements at a constant index and
; closure captures (Q_LDG_I, Q_LDEK_I, Q_LDU_I and the rest in src/vm/interp.c),
; and for len, must behave exactly like the generic mov and len: they take only
; a word or slot of the instruction's own type (a store sets it) and hand the
; rest to the generic instruction, which converts, retags or raises the usual
; error.
; expect-stdout: flushed
.include "std/test.inc"
.include "std/io.inc"

; Run one instruction and check that it raises an Error with this code.
.macro EXPECT_ERROR code, insn...
.try .Lh\@
    \insn
.endtry
    FAIL "an error was expected"
.Lh\@:
    catch R31
    strcmp I31, R31->Error.code, \code
    ASSERT_EQ I31, 0
.endm

.struct T
    n: i64
.ends

gi:     .i64 41
gf:     .f64 1.5
gr:     .i64 0
gnone:  .zero 8

; Reads and writes its captures: UP[0] i64, UP[1] f64, UP[2] a reference.
.func caps -> (i64, f64, ref)
    mov I0, UP[0]                        ; Q_LDU_I
    mov F0, UP[1]                        ; Q_LDU_F
    mov R0, UP[2]                        ; Q_LDU_R
    add I1, I0, 1
    mov UP[0], I1                        ; Q_STU_I: the closure keeps it
    mul F1, F0, 2.0
    mov UP[1], F1
    mov.r UP[2], null
    ret I0, F0, R0
.endf

; The capture's type changes: a store retags it, a read of another type is
; the generic path's (and its error).
.func retag -> i64
    mov.f64 UP[0], 2.0                   ; UP[0] was an i64
    mov F0, UP[0]
    cvt.i64.f64 I0, F0
    ret I0
.endf

.func read_int_cap -> i64
    mov I0, UP[0]
    ret I0
.endf

.func not_closure -> i64
    mov I0, UP[0]                        ; called directly: no closure
    ret I0
.endf

.func main
    ; ---- globals ----
    mov I0, @gi                          ; Q_LDG_I
    ASSERT_EQ I0, 41
    mov F0, @gf                          ; Q_LDG_F
    ASSERT_EQ F0, 1.5, f64
    add I0, 1
    mov @gi, I0                          ; Q_STG_I
    mov I1, @gi
    ASSERT_EQ I1, 42
    mov F1, 0.25
    mov @gf, F1                          ; Q_STG_F
    mov F2, @gf
    ASSERT_EQ F2, 0.25, f64
    lnew R0
    mov @gr, R0                          ; Q_STG_R: the word is now a reference
    mov R1, @gr
    seq.r I2, R1, R0
    ASSERT_TRUE I2
    EXPECT_ERROR "E_TYPE", mov I3, @gr   ; a reference word read as an integer
    mov @gr, I0                          ; overwritten with an integer: retagged
    mov I3, @gr
    ASSERT_EQ I3, 42
    EXPECT_ERROR "E_TYPE", mov R1, @gi   ; an integer word read as a reference
    mov I3, @gnone                       ; never written: zero
    ASSERT_EQ I3, 0
    mov @gf, I0                          ; an i64 into the f64's word: its bits
    mov F3, @gf                          ; read back as f64 (no conversion)
    bitcast.i64.f64 I4, F3
    ASSERT_EQ I4, 42

    ; ---- elements at a constant index ----
    lnew R2
    lpush R2, 10, 2.5, R0
    mov I5, R2[0]                        ; Q_LDEK_I
    ASSERT_EQ I5, 10
    mov F4, R2[1]                        ; Q_LDEK_F
    ASSERT_EQ F4, 2.5, f64
    mov R3, R2[2]                        ; Q_LDEK_R
    seq.r I6, R3, R0
    ASSERT_TRUE I6
    mov I7, 11
    mov R2[0], I7                        ; Q_STEK_I
    ASSERT_EQ R2[0], 11
    mov R2[1], I7                        ; a store retags a list element
    mov I8, R2[1]
    ASSERT_EQ I8, 11
    EXPECT_ERROR "E_TYPE", mov F5, R2[0]     ; an i64 element read as f64
    EXPECT_ERROR "E_BOUNDS", mov I8, R2[3]
    EXPECT_ERROR "E_BOUNDS", mov R2[9], I7
    anew.f64 R4, 2
    mov F5, 7.5
    mov R4[1], F5                        ; arrays: the declared element type
    mov F6, R4[1]
    ASSERT_EQ F6, 7.5, f64
    EXPECT_ERROR "E_TYPE", mov I8, R4[1]
    mov R5, null
    EXPECT_ERROR "E_NULL", mov I8, R5[0]
    new R6, T
    EXPECT_ERROR "E_TYPE", mov I8, R6[0] ; a struct is not indexed

    ; ---- closure captures ----
    closure caps (5, 1.25, R0) -> (R7)
    calli R7 -> (I9, F7, R8)
    ASSERT_EQ I9, 5
    ASSERT_EQ F7, 1.25, f64
    seq.r I10, R8, R0
    ASSERT_TRUE I10
    calli R7 -> (I9, F7, R8)             ; the captures it stored
    ASSERT_EQ I9, 6
    ASSERT_EQ F7, 2.5, f64
    ASSERT_FALSE R8, r
    closure retag (3) -> (R9)
    calli R9 -> (I11)
    ASSERT_EQ I11, 2
    closure read_int_cap (2.0) -> (R10)  ; an f64 capture read as i64
    EXPECT_ERROR "E_TYPE", calli R10 -> (I11)
    closure read_int_cap () -> (R10)     ; no captures
    EXPECT_ERROR "E_BOUNDS", calli R10 -> (I11)
    EXPECT_ERROR "E_TYPE", call not_closure -> (I11)

    ; ---- len ----
    len I12, R2                          ; Q_LEN: a list
    ASSERT_EQ I12, 3
    mov.r R11, "four"
    len I12, R11
    ASSERT_EQ I12, 4
    mnew R12
    mset R12, 1, 2
    len I12, R12
    ASSERT_EQ I12, 1
    len I12, R4
    ASSERT_EQ I12, 2
    EXPECT_ERROR "E_TYPE", len I12, R6   ; a struct
    EXPECT_ERROR "E_NULL", len I12, R5

    ; ---- io.flush ----
    PRINTLN_S "flushed"
    ncall "io.flush" ()
    ret 0
.endf
