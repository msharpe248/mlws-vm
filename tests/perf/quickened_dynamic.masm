; The quickened forms for the shapes compilers of dynamically typed languages
; emit (Q_CALL_RK and the rest in src/vm/interp.c) must behave exactly like the
; generic instructions: constants among call arguments and ret values, a
; reference constant or global moved into an R register, reference branches,
; f64 and reference set-compares, isa, and mget of a constant key. Each fast
; handler takes only the common case and hands the rest (a closure whose
; parameters do not fit a constant, a global that is not a reference, a value
; of another type in a map, a missing key without a default) to the generic
; instruction, which gives the usual result or error.
.include "std/test.inc"

.struct Box
    v: ref
.ends

.struct Other
    v: ref
.ends

; Run one instruction and check that it raises an Error with this code.
.macro EXPECT_ERROR code, insn...
.try .Lh\@
    \insn
.endtry
    FAIL "an error was expected"
.Lh\@:
    catch R31
    strcmp I31, R31->Error.code, \code
    ASSERT_EQ I31, 0
.endm

gref:   .i64 0                           ; written as a reference below
gint:   .i64 0                           ; written as an integer below
gnone:  .zero 8                          ; never written: reads as null

; A number half and a reference half, as a dynamic language passes a value.
.func pair(f64 x, ref r) -> (f64, ref)
    ret x, r
.endf

.func three(i64 a, f64 b, ref c) -> (i64, f64, ref)
    ret a, b, c
.endf

; ret with constants: an integer literal for an f64 result, null, a string
.func consts -> (f64, ref, i64)
    ret 7, "seven", 7
.endf

.func nulls -> (f64, ref)
    ret 0.0, null
.endf

.func takes_int(i64 a) -> i64
    ret a
.endf

.func main
    ; ---- calls with constant arguments ----
    call pair (1.5, null) -> (F0, R0)          ; Q_CALL_RK
    ASSERT_EQ F0, 1.5, f64
    ASSERT_FALSE R0, r
    call pair (2, "two") -> (F0, R0)           ; an integer literal for f64
    ASSERT_EQ F0, 2.0, f64
    strcmp I0, R0, "two"
    ASSERT_EQ I0, 0
    call three (-5, 0.25, null) -> (I1, F1, R1)
    ASSERT_EQ I1, -5
    ASSERT_EQ F1, 0.25, f64
    ASSERT_FALSE R1, r
    mov F2, 3.5
    call pair (F2, "mixed") -> (F0, R0)        ; registers and constants together
    ASSERT_EQ F0, 3.5, f64

    ; closure calls with constant arguments (Q_CALLI_RK), checked per call
    closure pair -> (R2)
    calli R2 (0.0, null) -> (F0, R0)
    ASSERT_EQ F0, 0.0, f64
    ASSERT_FALSE R0, r
    calli R2 (4, "four") -> (F0, R0)
    ASSERT_EQ F0, 4.0, f64
    closure takes_int -> (R3)
    calli R3 (12) -> (I2)
    ASSERT_EQ I2, 12
    EXPECT_ERROR "E_TYPE", calli R3 (1.5) -> (I2)    ; a float literal for an i64
    EXPECT_ERROR "E_TYPE", calli R3 ("s") -> (I2)    ; a string for an i64
    EXPECT_ERROR "E_TYPE", calli R2 (1.0, 5) -> (F0, R0) ; a non-zero integer for a ref
    EXPECT_ERROR "E_TYPE", calli R3 (1, 2) -> (I2)   ; the wrong count
    mov R4, null
    EXPECT_ERROR "E_NULL", calli R4 (1) -> (I2)

    ; ---- ret with constants (Q_RET_RK), to quickened and generic calls ----
    call consts -> (F0, R0, I3)
    ASSERT_EQ F0, 7.0, f64
    strcmp I0, R0, "seven"
    ASSERT_EQ I0, 0
    ASSERT_EQ I3, 7
    call nulls -> (F0, R0)
    ASSERT_FALSE R0, r
    enter 2
    call consts -> (LOC[0], R0, LOC[1])        ; results in memory: the generic ret
    ASSERT_EQ LOC[0], 7.0, f64
    ASSERT_EQ LOC[1], 7
    call consts -> (F0)                        ; fewer results than values
    ASSERT_EQ F0, 7.0, f64
    closure consts -> (R5)
    calli R5 -> (F0, R0, I3)
    ASSERT_EQ I3, 7

    ; ---- reference constants and globals into R registers ----
    mov.r R6, "k"                              ; Q_MOV_RK
    strcmp I0, R6, "k"
    ASSERT_EQ I0, 0
    mov.r R6, null
    ASSERT_FALSE R6, r
    new R7, Box
    mov.r @gref, R7
    mov.r R8, @gref                            ; Q_LDG_R
    seq.r I0, R8, R7
    ASSERT_TRUE I0
    mov.r R8, @gnone                           ; never written: the generic path, null
    ASSERT_FALSE R8, r
    mov.i64 @gint, 3
    EXPECT_ERROR "E_TYPE", mov.r R8, @gint     ; an integer word read as a reference

    ; ---- reference branches: register, constant, global ----
    mov R9, R7
    mov I4, 0
    beq.r R9, R7, 1f                           ; Q_BEQ_RR
    FAIL "beq.r RR"
1:  bne.r R9, R7, 2f                           ; Q_BNE_RR, not taken
    inc I4
2:  bne.r R9, null, 3f                         ; Q_BNE_RK
    FAIL "bne.r RK"
3:  beq.r R6, null, 4f                         ; Q_BEQ_RK
    FAIL "beq.r RK null"
4:  beq.r R9, @gref, 5f                        ; Q_BEQ_RG
    FAIL "beq.r RG"
5:  bne.r R9, @gref, 6f                        ; Q_BNE_RG, not taken
    inc I4
6:  ASSERT_EQ I4, 2
    EXPECT_ERROR "E_TYPE", beq.r R9, @gint, 7f ; the generic path's error
7:

    ; ---- set-compares ----
    mov F3, 1.0
    mov F4, 2.0
    slt.f64 I5, F3, F4                         ; Q_SLT_FF
    ASSERT_EQ I5, 1
    sge.f64 I5, F3, F4                         ; Q_SGE_FF
    ASSERT_EQ I5, 0
    sgt.f64 I5, F4, 1                          ; Q_SGT_FK, an integer literal
    ASSERT_EQ I5, 1
    sle.f64 I5, F4, 2.0
    ASSERT_EQ I5, 1
    seq.f64 I5, F3, 1.0
    ASSERT_EQ I5, 1
    sne.f64 I5, F3, 1.0
    ASSERT_EQ I5, 0
    div F5, 0.0, 0.0                           ; NaN: unordered
    seq.f64 I5, F5, F5
    ASSERT_EQ I5, 0
    sne.f64 I5, F5, F5
    ASSERT_EQ I5, 1
    slt.f64 I5, F5, 1.0
    ASSERT_EQ I5, 0
    sge.f64 I5, F5, 1.0
    ASSERT_EQ I5, 0
    ; f64 compare-and-branch (Q_BLT_FFL, Q_BGE_FKL, ...): NaN is unordered
    mov I8, 0
    blt.f64 F3, F4, 10f                        ; 1 < 2: taken
    FAIL "blt.f64 FF"
10: bge.f64 F3, 2, 11f                         ; an integer literal: not taken
    inc I8
11: bgt.f64 F4, F3, 12f
    FAIL "bgt.f64 FF"
12: ble.f64 F4, 2.0, 13f
    FAIL "ble.f64 FK"
13: beq.f64 F5, F5, 14f                        ; NaN == NaN: not taken
    inc I8
14: bne.f64 F5, F5, 15f                        ; NaN != NaN: taken
    FAIL "bne.f64 NaN"
15: blt.f64 F5, 1.0, 16f                       ; not taken
    inc I8
16: bge.f64 F5, 1.0, 17f                       ; not taken
    inc I8
17: ASSERT_EQ I8, 4
    seq.r I5, R9, R7                           ; Q_SEQ_RR
    ASSERT_EQ I5, 1
    sne.r I5, R9, null                         ; Q_SNE_RK
    ASSERT_EQ I5, 1
    seq.r I5, R0, "seven"                      ; identity, not content: another object
    mov.r R10, "x"
    seq.r I5, R10, "x"                         ; the same constant: identical
    ASSERT_EQ I5, 1

    ; ---- isa ----
    isa I6, R7, Box                            ; Q_ISA
    ASSERT_EQ I6, 1
    isa I6, R7, Other
    ASSERT_EQ I6, 0
    isa I6, R6, Box                            ; null
    ASSERT_EQ I6, 0
    isa I6, R10, Box                           ; a string
    ASSERT_EQ I6, 0

    ; ---- mget of a constant key ----
    mnew R11
    mset R11, "a", R7
    mset R11, "n", 5
    mget.r R12, R11, "a", null                 ; Q_MGET_R
    seq.r I7, R12, R7
    ASSERT_TRUE I7
    mget.r R12, R11, "missing", null           ; the default
    ASSERT_FALSE R12, r
    mget.r R12, R11, "a"                       ; no default, present
    seq.r I7, R12, R7
    ASSERT_TRUE I7
    EXPECT_ERROR "E_KEY", mget.r R12, R11, "missing"
    EXPECT_ERROR "E_TYPE", mget.r R12, R11, "n", null ; an integer value
    EXPECT_ERROR "E_TYPE", mget.r R12, R7, "a", null  ; not a map
    mov R13, null
    EXPECT_ERROR "E_NULL", mget.r R12, R13, "a", null
    ret 0
.endf
