; The quickened forms added for compiled Lua's code (M29 in src/vm/interp.c)
; must behave exactly like the generic instructions: new of a struct and lnew
; of a constant capacity; a constant stored to a struct field; mget of a key in
; any register into each bank, with or without a constant default; jtab;
; cvt.f64.i64; 64-bit shifts by a register or a constant; f64 arithmetic with a
; constant first operand; and unsigned compare-and-branch. Each fast handler
; takes only the common case and hands the rest (another struct, a value of
; another type, a missing key without a default, a bad capacity) to the
; generic instruction, which gives the usual result or error.
.include "std/test.inc"

.struct Cell
    i: i64
    f: f64
    r: ref
.ends

.struct Other
    i: i64
.ends

.macro EXPECT_ERROR code, insn...
.try .Lh\@
    \insn
.endtry
    FAIL "an error was expected"
.Lh\@:
    catch R31
    strcmp I31, R31->Error.code, \code
    ASSERT_EQ I31, 0
.endm

; jtab: the case number for 0, 1 and 2; anything else falls through to 9.
.func pick(i64 k) -> i64
    jtab k, 1f, 2f, 3f
    ret 9
1:  ret 10
2:  ret 11
3:  ret 12
.endf

.func main
    ; ---- new: every field starts as zero or null ----
    new R0, Cell                              ; Q_NEW
    ASSERT_EQ R0->Cell.i, 0
    ASSERT_EQ R0->Cell.f, 0.0
    ASSERT_EQ R0->Cell.r, null, r

    ; ---- constants stored to fields ----
    mov.i64 R0->Cell.i, -5                     ; Q_STFK
    mov.f64 R0->Cell.f, 2                      ; an integer literal stored as 2.0
    mov.r R0->Cell.r, "text"
    ASSERT_EQ R0->Cell.i, -5
    ASSERT_EQ R0->Cell.f, 2.0
    strcmp I0, R0->Cell.r, "text"
    ASSERT_EQ I0, 0
    mov.r R0->Cell.r, null
    ASSERT_EQ R0->Cell.r, null, r
    new R1, Other
    EXPECT_ERROR "E_TYPE", mov.i64 R1->Cell.i, 1     ; another struct: generic
    mov.r R2, null
    EXPECT_ERROR "E_NULL", mov.i64 R2->Cell.i, 1

    ; ---- lnew of a constant capacity, or none ----
    lnew R3, 4                                 ; Q_LNEW
    len I1, R3
    ASSERT_EQ I1, 0
    lpush R3, 1, 2, 3, 4, 5                    ; past the capacity: grows
    len I1, R3
    ASSERT_EQ I1, 5
    ASSERT_EQ R3[4], 5
    lnew R4
    lpush R4, 7
    ASSERT_EQ R4[0], 7
    EXPECT_ERROR "E_BAD_ALLOC", lnew R5, -1

    ; ---- mget of a register key, into each bank ----
    mnew R6
    mset R6, "n", 42
    mset R6, "x", 2.5
    mset R6, "s", R0
    mset R6, 3, 30
    mset R6, 1.5, "one and a half"
    mov R7, "n"
    mget I2, R6, R7, -1                        ; Q_MGETV_I, no suffix: i64
    ASSERT_EQ I2, 42
    mov R7, "x"
    mget.f64 F0, R6, R7                        ; Q_MGETV_F, no default
    ASSERT_EQ F0, 2.5
    mov R7, "s"
    mget R8, R6, R7, null                      ; Q_MGETV_R
    ASSERT_EQ R8->Cell.i, -5
    mov I3, 3
    mget I4, R6, I3                            ; an integer key
    ASSERT_EQ I4, 30
    mov.f64 F1, 1.5
    mget R9, R6, F1                            ; a float key
    strcmp I5, R9, "one and a half"
    ASSERT_EQ I5, 0
    mov R7, "missing"
    mget I6, R6, R7, -1                        ; the defaults
    ASSERT_EQ I6, -1
    mget.f64 F2, R6, R7, 7                     ; an integer literal default for f64
    ASSERT_EQ F2, 7.0
    mget R10, R6, R7, null
    ASSERT_EQ R10, null, r
    mov.f64 F3, 3.0
    mget I7, R6, F3, -1                        ; 3.0 is not the key 3
    ASSERT_EQ I7, -1
    EXPECT_ERROR "E_KEY", mget I8, R6, R7      ; no default: generic
    mov R7, "x"
    EXPECT_ERROR "E_TYPE", mget I8, R6, R7, -1 ; an f64 value for an i64: generic
    EXPECT_ERROR "E_TYPE", mget I8, R0, R7, -1 ; not a map: generic

    ; ---- jtab ----
    call pick (0) -> (I9)
    ASSERT_EQ I9, 10
    call pick (2) -> (I9)
    ASSERT_EQ I9, 12
    call pick (3) -> (I9)                      ; past the last case
    ASSERT_EQ I9, 9
    call pick (-1) -> (I9)                     ; negative
    ASSERT_EQ I9, 9

    ; ---- cvt.f64.i64 ----
    mov I10, -7
    cvt.f64.i64 F4, I10                        ; Q_CVT_FI
    ASSERT_EQ F4, -7.0
    mov I10, 9007199254740993                  ; 2^53 + 1 rounds to even
    cvt.f64.i64 F4, I10
    ASSERT_EQ F4, 9007199254740992.0

    ; ---- shifts: counts modulo 64 ----
    mov I11, 1
    mov I12, 65
    shl I13, I11, I12                          ; Q_SHL_III: by 65 is by 1
    ASSERT_EQ I13, 2
    shl I13, I11, 63                           ; Q_SHL_IIK
    ASSERT_EQ I13, -9223372036854775808
    mov I14, -16
    shr I15, I14, 60                           ; logical: the sign bit moves down
    ASSERT_EQ I15, 15
    sar I15, I14, 2                            ; arithmetic: the sign stays
    ASSERT_EQ I15, -4
    mov I15, -16
    sar I15, 64                                ; Q_SAR_IK: by 64 is by 0
    ASSERT_EQ I15, -16
    mov I12, 4
    shr I15, I12                               ; Q_SHR_II: -16 >> 4, logically
    ASSERT_EQ I15, 1152921504606846975

    ; ---- f64 with a constant first operand ----
    mov.f64 F5, 4.0
    div.f64 F6, 1.0, F5                        ; Q_FDIV_FKF
    ASSERT_EQ F6, 0.25
    sub.f64 F6, 10, F5                         ; an integer literal: 10.0
    ASSERT_EQ F6, 6.0
    add.f64 F6, 0.5, F5
    ASSERT_EQ F6, 4.5
    mul.f64 F6, -2.0, F5
    ASSERT_EQ F6, -8.0

    ; ---- unsigned compare-and-branch ----
    mov I16, -1                                ; the largest u64
    mov I17, 5
    bge.u64 I16, I17, 1f                       ; Q_BGE_UU
    FAIL "-1 is the largest u64"
1:  blt.u64 I16, I17, 2f
    bgt.u64 I17, 4, 3f                         ; Q_BGT_UK
2:  FAIL "unsigned order"
3:  ble.u64 I17, -1, 4f
    FAIL "5 <= max u64"
4:  blt I16, I17, 5f                           ; signed: -1 < 5
    FAIL "signed order"
5:  ret 0
.endf
