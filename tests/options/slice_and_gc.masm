; Extreme settings still give correct results: a one-instruction time slice
; (a process switch after every instruction) and a 4 KiB collection threshold.
; option: --slice 1
; option: --gc-min 4K
; threads: 2
.include "std/test.inc"
.func worker(i64 parent, i64 n)
    mov I2, 0
    mov I3, 0
1:  tostr R0, I3                       ; garbage for the collector
    add I2, I3
    inc I3
    blt I3, n, 1b
    ncall "gc.collections" () -> (I4)
    lnew R1                            ; one message: workers' messages interleave
    lpush R1, I2, I4
    send parent, R1
    ret
.endf
.func main
    mov I0, 0
1:  spawn worker (PID, 2000)
    inc I0
    blt I0, 4, 1b
    mov I0, 0
2:  recv R0
    mov I1, R0[0]
    ASSERT_EQ I1, 1999000              ; 0 + 1 + ... + 1999
    mov I2, R0[1]
    ASSERT_GT I2, 0                    ; the small threshold made it collect
    inc I0
    blt I0, 4, 2b
    ret 0
.endf
