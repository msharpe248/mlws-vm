; std.node - processes on other VMs: send to them, spawn on them, watch them.
;
;     .import std.node as node
;     call node.start (1, "secret", 4370) -> (I0)     ; this VM is node 1, listening
;     call node.connect ("db.local", 4370, "secret") -> (I1)   ; its number
;     (start_tls and connect_tls: the same, encrypted)
;     call node.spawn (I1, "worker", "serve", R0) -> (I2)      ; a pid over there
;     send I2, "hello"                                ; send works on it as on any pid
;     call node.whereis (I1, "logger") -> (I3)
;     monitor I2                                      ; a Down when it ends
;     call node.self (PID) -> (I4)                    ; a pid others can use
;     call node.set_name ("db@host")                  ; (before connecting) a name too:
;     call node.name (I1) -> (R1)                     ; each node learns the other's
;
; A pid with a node's number in its top 16 bits works with send, link, monitor,
; kill and proc.call anywhere in the cluster; a plain pid means this VM. A VM has one number, from 1 to 65535,
; unique in its cluster. Two nodes are connected by one TCP connection, once
; each has proved it knows the cookie: each sends a nonce and answers the other's
; with an HMAC of it, marked with which end it is. Plain connections are not
; encrypted, so a cluster that uses them belongs on a network you trust. With
; start_tls and connect_tls the connection is TLS first: the connecting node
; checks the other's certificate against its host name, and the cookie is
; proved over the encrypted link. A connected node may
; message any process and spawn any exported function, as in Erlang: the cookie
; is the whole of the boundary.
;
; A connection is two processes, sharing its TLS session if it has one. The
; reader takes frames from the socket and acts on them. The writer takes what
; the VM routes to this node, as [pid, value], and what this module and the VM
; ask for, as [null, kind, ...], and writes frames. Frames are lists:
;     [0, pid, value]                      a message
;     [1, reply_to, module, function, args]  spawn function(args), args one value
;     [2, reply_to, name]                  the pid registered as name, or 0
;     [3 to 10, pid, ...]                  link, unlink, exit, monitor, down,
;                                          reply, noproc and kill: the VM's, for
;                                          link, monitor, proc.call and kill
;                                          across nodes
;                                          (node.control)
; When the connection goes, the reader clears its route (node.attach), and the
; VM acts as if every process over there had failed with E_NODE_DOWN.

.module std.node
.export start, start_tls, connect, connect_tls, spawn, whereis, self, node_of, connected
.export set_name, name, number, nodes, watch, unwatch
.export start_named, start_tls_named, connect_named, connect_tls_named, names

.const NAMES_PORT = 4368

.const CONNECT_TIMEOUT = 5000

; ---- this VM as a node ----

; Number this VM, and accept connections on a port (0: any free one). Returns
; the port.
.func start(i64 number, ref cookie, i64 port) -> i64
    call start_tls (number, cookie, port, null, null) -> (I3)
    ret I3
.endf

; The same, accepting only TLS, with PEM files of a certificate chain and its key.
.func start_tls(i64 number, ref cookie, i64 port, ref cert, ref key) -> i64
    ncall "node.set_self" (number)
    spawn acceptor (cookie, port, PID, cert, key)
    recv I3
    ret I3
.endf

.func acceptor(ref cookie, i64 port, i64 parent, ref cert, ref key)
    ncall "net.listen" ("", port) -> (R3)
    ncall "net.port" (R3) -> (I2)
    send parent, I2
1:  ncall "net.accept" (R3) -> (R4)
    ncall "fs.give" (R4) -> (I3)
    spawn answer (I3, cookie, cert, key)
    jmp 1b
.endf

; A pid as other nodes can use it.
.func self(i64 pid) -> i64
    ncall "node.global" (pid) -> (I1)
    ret I1
.endf

; The node a pid names (0: this one).
.func node_of(i64 pid) -> i64
    ncall "node.of" (pid) -> (I1)
    ret I1
.endf

; Whether a node is connected.
.func connected(i64 number) -> i64
    ncall "node.route" (number) -> (I1)
    bz I1, 1f
    ret 1
1:  ret 0
.endf

; The numbers of the nodes connected now, as a list, in order.
.func nodes -> ref
    ncall "node.nodes" () -> (R0)
    ret R0
.endf

; From now on, a NodeEvent {node, name, up} comes to this process for each
; connection to another node that comes (up true) or goes (false); when one
; goes, after the Downs and failures it causes. unwatch stops them.
.func watch
    ncall "node.watch" (1)
    ret
.endf
.func unwatch
    ncall "node.watch" (0)
    ret
.endf

; Name this VM (as Erlang's name@host), once, before it connects: each node it
; connects to learns the name.
.func set_name(ref name)
    ncall "node.set_name" (name)
    ret
.endf

; A node's name, as it gave it when it last connected; this VM's for 0; "" if
; none is known.
.func name(i64 number) -> ref
    ncall "node.name" (number) -> (R1)
    ret R1
.endf

; The number of the node with this name (this VM's, a connected node's, or the
; last that had it), or 0.
.func number(ref name) -> i64
    ncall "node.number" (name) -> (I1)
    ret I1
.endf

; ---- connecting ----

; Connect to a node. Returns its number; E_NODE if it could not be done. The
; connection's processes do the asking, so nothing comes to this one's mailbox.
.func connect(ref host, i64 port, ref cookie) -> i64
    call connect_tls (host, port, cookie, null) -> (I3)
    ret I3
.endf

; The same over TLS: the node's certificate must match host and come from an
; authority in the PEM file ca ("": the system's).
.func connect_tls(ref host, i64 port, ref cookie, ref ca) -> i64
    spawn dial (host, port, cookie, ca) -> (I2)
    ncall "proc.call" (I2, "connect", 15000) -> (R4)
    mov I3, R4[0]
    bz I3, 1f
    ret I3
1:  new R5, Error
    mov R5->Error.code, "E_NODE"
    mov R6, R4[1]                      ; why
    strcat R7, "could not connect to the node: ", R6
    mov R5->Error.message, R7
    throw R5
.endf

.func dial(ref host, i64 port, ref cookie, ref ca)
    recv R4                            ; the Call
    lnew R5
.try failed
    ncall "net.connect" (host, port, CONNECT_TIMEOUT) -> (R6)
    bz ca, 1f
    ncall "tls.connect" (R6, host, ca)
1:  call handshake (R6, cookie, "client", "server") -> (I2)
    call carry (R6, I2)
.endtry
    lpush R5, I2
    ncall "proc.reply" (R4, R5)
    call read_frames (R6, I2)
    ret
failed:
    catch R7
    lpush R5, 0
    mov R8, R7->Error.message
    lpush R5, R8
    ncall "proc.reply" (R4, R5)
    ret
.endf

.func answer(i64 ticket, ref cookie, ref cert, ref key)
    ncall "fs.take" (ticket) -> (R3)
    bz cert, 1f
    ncall "tls.accept" (R3, cert, key)
1:  call handshake (R3, cookie, "server", "client") -> (I2)
    call carry (R3, I2)
    call read_frames (R3, I2)
    ret
.endf

; Each end sends [number, nonce, name], then proves the cookie against the
; other's nonce in its own role. Returns the peer's number, whose name is then
; known here; E_NODE if another node connected now, or this one, has that name.
; (A peer that sends no name, as before names, has none.)
.func handshake(ref conn, ref cookie, ref me, ref them) -> i64
    ncall "random.bytes" (32) -> (R4)
    ncall "node.self" () -> (I0)
    ncall "node.name" (0) -> (R17)
    lnew R5
    lpush R5, I0
    lpush R5, R4
    lpush R5, R17
    ncall "node.frame" (R5) -> (R6)
    ncall "fs.write" (conn, R6)
    ncall "net.read_frame" (conn) -> (R7)
    bz R7, gone
    ncall "node.decode" (R7) -> (R8)
    mov I1, R8[0]
    mov R9, R8[1]
    ncall "node.proof" (cookie, me, R9) -> (R10)
    lnew R11
    lpush R11, R10
    ncall "node.frame" (R11) -> (R12)
    ncall "fs.write" (conn, R12)
    ncall "net.read_frame" (conn) -> (R13)
    bz R13, gone
    ncall "node.decode" (R13) -> (R14)
    mov R15, R14[0]
    ncall "node.proof_ok" (cookie, them, R4, R15) -> (I2)
    bz I2, refused
    mov R18, ""
    len I3, R8
    blt I3, 3, 1f
    mov R18, R8[2]
1:  ncall "node.named" (I1, R18) -> (I4)
    bz I4, taken
    ret I1
gone:
    new R16, Error
    mov R16->Error.code, "E_NODE"
    mov R16->Error.message, "the peer went away"
    throw R16
refused:
    new R16, Error
    mov R16->Error.code, "E_NODE"
    mov R16->Error.message, "the peer does not know the cookie"
    throw R16
taken:
    strcat R19, "the peer's name (", R18, ") or number is this node's or a connected node's"
    new R16, Error
    mov R16->Error.code, "E_NODE"
    mov R16->Error.message, R19
    throw R16
.endf

; The writer, on its own handle of the connection, and the route to it.
.func carry(ref conn, i64 peer)
    ncall "net.split" (conn) -> (R2)
    ncall "fs.give" (R2) -> (I2)
    spawn writer (I2, PID) -> (I3)
    ncall "node.attach" (peer, I3)
    ret
.endf

; What goes to the node at the other end: frames for the wire, as bytes, made
; where they were sent (messages, and what the VM asks for), and this module's
; own requests, as [null, kind, ...]. Frames waiting behind one go with it, up
; to 64 KiB, in one write, and what it writes is room for senders that wait
; while it has more than 1 MiB to write (node.written). Ends with the reader.
.func writer(i64 ticket, i64 reader)
    ncall "fs.take" (ticket) -> (R0)
    monitor reader
1:  recv R2
2:  typeof I2, R2
    beq I2, 2, frame                   ; (2: bytes)
    isa I2, R2, Down
    bnz I2, ended
    ldel R2, 0                         ; a request: [null, kind, ...]
    ncall "node.frame" (R2) -> (R3)
    ncall "fs.write" (R0, R3)
    jmp 1b
frame:
    mlen I3
    bz I3, 5f
    bufnew R4, 0
    bufcat R4, R2
3:  len I4, R4
    bge I4, 65536, 4f
    recvt R2, 0, 4f
    typeof I2, R2
    bne I2, 2, 6f                      ; (not a frame: after what is gathered)
    bufcat R4, R2
    jmp 3b
4:  ncall "fs.write" (R0, R4)
    call written (R4)
    jmp 1b
6:  ncall "fs.write" (R0, R4)
    call written (R4)
    jmp 2b
5:  ncall "fs.write" (R0, R2)
    call written (R2)
    jmp 1b
ended:
    ncall "fs.close" (R0)
    ret
.endf

; Frames written: room for senders waiting for it (back-pressure).
.func written(ref frames)
    len I1, frames
    ncall "node.written" (I1)
    ret
.endf

; A frame: a message, delivered (null); or another frame's value; or null if
; it cannot be read here (a struct this VM does not have, bytes that are not a
; value): then it is dropped, with a warning in the monitor's log, and the
; connection goes on, since frames come one by one.
.func read_one(ref bytes, i64 peer) -> ref
.try bad
    ncall "node.take" (bytes, peer) -> (R2)
.endtry
    ret R2
bad:
    catch R3
    mov R4, R3->Error.code
    mov R5, R3->Error.message
    tostr R6, peer
    strcat R7, "std.node: a frame from node ", R6, " was dropped: [", R4, "] ", R5
    ncall "monitor.log" (2, R7)
    ret null
.endf

.func read_frames(ref conn, i64 peer)
.try lost
1:  ncall "net.read_frame" (conn) -> (R2)
    bz R2, closed
    call read_one (R2, peer) -> (R3)
    bz.r R3, 1b                        ; (a message, delivered; or dropped)
    mov I2, R3[0]
    bz I2, 1b                          ; (a message node.take could not see as one: malformed)
    beq I2, 1, 3f
    beq I2, 2, 4f
    bgt I2, 11, 1b                     ; (a kind of a later version: dropped)
    ncall "node.control" (R3)          ; 3 to 11
    jmp 1b
3:  spawn do_spawn (R3)
    jmp 1b
4:  mov I3, R3[1]
    mov R4, R3[2]
    ncall "proc.whereis" (R4) -> (I4)
    bz I4, 6f
    ncall "node.global" (I4) -> (I4)
6:  lnew R5
    lpush R5, I4
    send I3, R5
    jmp 1b
.endtry
closed:
    ncall "node.attach" (peer, 0)
    ret
lost:
    catch R5
    ncall "node.attach" (peer, 0)
    ret
.endf

; [1, reply_to, module, function, args]: spawned here, its pid sent back.
.func do_spawn(ref frame)
    mov I1, frame[1]
    mov R1, frame[2]
    mov R2, frame[3]
    mov R3, frame[4]
.try failed
    ncall "node.function" (R1, R2) -> (R4)
    spawni R4 (R3) -> (I2)
.endtry
    ncall "node.global" (I2) -> (I2)
    lnew R5
    lpush R5, I2
    send I1, R5
    ret
failed:
    catch R6
    lnew R5
    lpush R5, 0
    send I1, R5
    ret
.endf

; ---- asking another node ----

; A request gets an answer through a process of its own, so that what the caller
; has in its mailbox stays there.
.func ask(i64 peer, ref frame) -> ref
    spawn asker (peer, frame) -> (I2)
    ncall "proc.call" (I2, "ask", 10000) -> (R3)
    ret R3
.endf

.func asker(i64 peer, ref frame)
    recv R1                            ; the Call
    ncall "node.route" (peer) -> (I2)
    bz I2, none
    ncall "node.global" (PID) -> (I3)
    mov R2, frame
    mov R2[2], I3                      ; [null, kind, reply_to, ...]
    send I2, R2
    recv R3
    ncall "proc.reply" (R1, R3)
    ret
none:
    lnew R3
    lpush R3, 0
    ncall "proc.reply" (R1, R3)
    ret
.endf

; Run a module's exported function, with one reference, on a node. Returns its
; pid there, or 0 if that could not be done.
.func spawn(i64 peer, ref module, ref function, ref arg) -> i64
    lnew R4
    lpush R4, null
    lpush R4, 1
    lpush R4, 0
    lpush R4, module
    lpush R4, function
    lpush R4, arg
    call ask (peer, R4) -> (R5)
    mov I6, R5[0]
    ret I6
.endf

; The pid registered under a name on a node, or 0.
.func whereis(i64 peer, ref name) -> i64
    lnew R2
    lpush R2, null
    lpush R2, 2
    lpush R2, 0
    lpush R2, name
    call ask (peer, R2) -> (R3)
    mov I4, R3[0]
    ret I4
.endf

; ---- by name (std.names: `mlwsvm names`, one per machine) ----

; The port of this machine's name service: $MLWSVM_NAMES_PORT, or 4368.
.func names_port -> i64
.try none
    ncall "os.env" ("MLWSVM_NAMES_PORT") -> (R0)
.endtry
    bz.r R0, 1f
.try none
    parse.i64 I0, R0
.endtry
    ret I0
none:
    catch R1
1:  ret NAMES_PORT
.endf

; The name before a full name's last @ (all of it if it has none), and the host
; after it ("127.0.0.1" if none).
.func short_of(ref full) -> ref
    call at_of (full) -> (I1)
    blt I1, 0, 1f
    substr R1, full, 0, I1
    ret R1
1:  ret full
.endf
.func host_of(ref full) -> ref
    call at_of (full) -> (I1)
    blt I1, 0, 1f
    add I2, I1, 1
    len I3, full
    sub I3, I3, I2
    substr R1, full, I2, I3
    ret R1
1:  ret "127.0.0.1"
.endf
.func at_of(ref full) -> i64
    mov I1, -1
    mov I2, 0
1:  ncall "text.find" (full, "@", I2) -> (I3)
    blt I3, 0, 2f
    mov I1, I3
    add I2, I3, 1
    jmp 1b
2:  ret I1
.endf

.func name_error(ref text)
    new R1, Error
    mov R1->Error.code, "E_NODE"
    mov R1->Error.message, text
    throw R1
.endf

; Name this VM (as Erlang's name@host) and number it (0: a number made from
; the name, node.number_for), accept connections on a port (0: any), and
; register the name, its part before the @, with this machine's name service,
; for as long as this VM lives. Returns the port. E_NODE if there is no name
; service, or the name is registered already.
.func start_named(ref name, i64 number, ref cookie, i64 port) -> i64
    call start_tls_named (name, number, cookie, port, null, null) -> (I3)
    ret I3
.endf

; The same, accepting only TLS (as start_tls).
.func start_tls_named(ref name, i64 number, ref cookie, i64 port, ref cert, ref key) -> i64
    call set_name (name)
    bnz number, 1f
    ncall "node.number_for" (name) -> (I0)
1:  call start_tls (I0, cookie, port, cert, key) -> (I3)
    call names_port -> (I4)
.try no_service
    ncall "net.connect" ("127.0.0.1", I4, CONNECT_TIMEOUT) -> (R6)
.endtry
    call short_of (name) -> (R7)
    tostr R8, I3
    strcat R9, "REGISTER ", R7, " ", R8, "\n"
    ncall "fs.write" (R6, R9)
    ncall "fs.read_line" (R6) -> (R10)
    bz.r R10, no_service2
    strcmp I5, R10, "OK"
    bnz I5, taken
    ncall "fs.give" (R6) -> (I6)
    spawn hold_name (I6)                ; (the registration lasts while it does)
    ret I3
no_service:
    catch R11
no_service2:
    tostr R12, I4
    strcat R13, "no name service on this machine at port ", R12, " (start one: mlwsvm names)"
    call name_error (R13)
    ret 0
taken:
    strcat R13, "the name service says ", R10, " to ", R7
    call name_error (R13)
    ret 0
.endf

; Keeps a registration's connection open, while this VM lives or the service does.
.func hold_name(i64 ticket)
    ncall "fs.take" (ticket) -> (R0)
.try ended
1:  ncall "fs.read_line" (R0) -> (R1)
    bnz.r R1, 1b
.endtry
    ret
ended:
    catch R2
    ret
.endf

; Ask a host's name service one line; its first answer line, or null.
.func ask_names(ref host, ref line) -> ref
    call names_port -> (I1)
    ncall "net.connect" (host, I1, CONNECT_TIMEOUT) -> (R2)
    ncall "fs.write" (R2, line)
    ncall "fs.read_line" (R2) -> (R3)
    ncall "fs.close" (R2)
    ret R3
.endf

; Connect to the node of a full name (name@host), finding its port with its
; host's name service. Returns its number; E_NODE if it is not registered there.
.func connect_named(ref full, ref cookie) -> i64
    call connect_tls_named (full, cookie, null) -> (I3)
    ret I3
.endf

; The same over TLS, as connect_tls (ca: "" for the system's authorities).
.func connect_tls_named(ref full, ref cookie, ref ca) -> i64
    call short_of (full) -> (R3)
    call host_of (full) -> (R4)
    strcat R5, "PORT ", R3, "\n"
.try unreachable
    call ask_names (R4, R5) -> (R6)
.endtry
    mov I1, 0
    bz.r R6, 1f
    parse.i64 I1, R6
1:  bz I1, unknown
    bz.r ca, 2f
    call connect_tls (R4, I1, cookie, ca) -> (I2)
    ret I2
2:  call connect (R4, I1, cookie) -> (I2)
    ret I2
unreachable:
    catch R7
    strcat R8, "no name service at ", R4, " to find ", full
    call name_error (R8)
    ret 0
unknown:
    strcat R8, "no node named ", R3, " is registered at ", R4
    call name_error (R8)
    ret 0
.endf

; What a host's name service knows: a list of [name, port].
.func names(ref host) -> ref
    call names_port -> (I1)
    ncall "net.connect" (host, I1, CONNECT_TIMEOUT) -> (R2)
    ncall "fs.write" (R2, "NAMES\n")
    lnew R3
1:  ncall "fs.read_line" (R2) -> (R4)
    bz.r R4, 2f
    strcmp I2, R4, "END"
    bz I2, 2f
    ncall "text.split" (R4, " ") -> (R5)
    mov R6, R5[0]
    mov R7, R5[1]
    parse.i64 I3, R7
    lnew R8
    lpush R8, R6, I3
    lpush R3, R8
    jmp 1b
2:  ncall "fs.close" (R2)
    ret R3
.endf
