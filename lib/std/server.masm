; std.server - a generic server, as Erlang/OTP's gen_server: a process that
; keeps a state, answers requests with a callback module's functions, and
; carries its state over to each new version of that module a reload brings.
;
;     .import std.server as server
;     ncall "module.function" ("counter", "init") -> (R0)   ; the callback module, by its init
;     call server.start (R0, arg) -> (I0)
;     ncall "proc.call" (I0, request, 5000) -> (R1)          ; handle_call's reply
;
; The callback module exports:
;
;     init(ref arg) -> ref                                   the first state
;     handle_call(ref request, ref state) -> (ref, ref)      a Call's reply, and the next state
;     handle_info(ref message, ref state) -> ref             any other message (optional: else dropped)
;     code_change(ref state) -> ref                          the state for a new version (optional)
;
; The server runs the version of the module it started with until a reload
; brings in a new one. It hears of that by a Reloaded (module.watch), which
; comes before any message the new version's code sends. Then it calls the
; new version's code_change, if it has one, with its state, and the new
; version's functions from then on. So the old version handles the messages
; that came before, with the state it made, and the new version sees only a
; state code_change gave it, as Erlang's sys:change_code makes sure of by
; suspending the process. A reload that brings no version newer than the one
; it runs (two reloads, met at the first) changes nothing.
;
; Messages are references (a number sent to it fails it with E_TYPE). A
; callback that raises ends the server with that error, as a failure, for its
; links and monitors to see.

.module std.server
.export start

; Start a server process, from any closure of the callback module's (its
; init, say); returns its pid.
.func start(ref module, ref arg) -> i64
    spawn run (module, arg) -> (I2)
    ret I2
.endf

; The callbacks of the version f is of: [handle_call, handle_info or null,
; code_change or null, that version's number].
.func callbacks(ref f) -> ref
    lnew R1
    ncall "module.function" (f, "handle_call") -> (R2)
    lpush R1, R2
    call optional (f, "handle_info") -> (R2)
    lpush R1, R2
    call optional (f, "code_change") -> (R2)
    lpush R1, R2
    ncall "module.of" (f) -> (R3, I4)
    lpush R1, I4
    ret R1
.endf

; A function that f's version exports, or null.
.func optional(ref f, ref name) -> ref
.try none
    ncall "module.function" (f, name) -> (R2)
.endtry
    ret R2
none:
    catch R3
    ret null
.endf

.func run(ref module, ref arg)
    ncall "module.of" (module) -> (R2, I3)
    ncall "module.watch" (R2, 1)
    ; The version current now: any newer comes as a Reloaded from here on.
    ncall "module.current" (module, "init") -> (R4)
    call callbacks (R4) -> (R5)
    calli R4 (arg) -> (R6)             ; the state
1:  recv R7
    isa I8, R7, Call
    bz I8, 2f
    mov R9, R5[0]
    mov R10, R7->Call.body
    calli R9 (R10, R6) -> (R11, R6)
    ncall "proc.reply" (R7, R11)
    jmp 1b
2:  isa I8, R7, Reloaded
    bz I8, 4f
    mov R10, R7->Reloaded.module
    strcmp I8, R10, R2
    bnz I8, 4f                         ; (another module's: a message for handle_info)
    mov R9, R5[0]
    ncall "module.current" (R9, "handle_call") -> (R12)
    call callbacks (R12) -> (R13)
    mov I14, R13[3]
    mov I15, R5[3]
    beq I14, I15, 1b                   ; (none newer than this)
    mov R5, R13
    mov R9, R5[2]
    bz.r R9, 1b
    calli R9 (R6) -> (R6)
    jmp 1b
4:  mov R9, R5[1]
    bz.r R9, 1b
    calli R9 (R7, R6) -> (R6)
    jmp 1b
.endf
