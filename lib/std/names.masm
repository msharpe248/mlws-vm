; std.names - a name service for nodes, as Erlang's epmd: one per machine,
; `mlwsvm names [--port N]` (4368 unless told), from which a node's port is
; found by its name (std.node's connect_named), once the node has registered
; it (start_named). A registration lasts while the node's connection to the
; service stays open, and is taken only from this machine; anyone may ask.
;
; The protocol is a line, and its answer:
;     REGISTER name port   OK, or TAKEN (or REFUSED, from another machine);
;                          then the registration holds until the connection
;                          closes
;     PORT name            the port, or 0
;     NAMES                "name port" for each, then END
; Anything else is answered ERROR. The answers end with "\n".
.module std.names
.export main

.const DEFAULT_PORT = 4368

; The port from the first argument, or the default; then the registry, and a
; process for each connection.
.func main
    mov I1, DEFAULT_PORT
    ncall "os.args" () -> (R0)
    len I2, R0
    bz I2, 1f
    mov R1, R0[0]
    parse.i64 I1, R1
1:  spawn registry -> (I3)
    ncall "net.listen" ("", I1) -> (R2)
    ncall "net.port" (R2) -> (I4)
    tostr R3, I4
    strcat R4, "mlwsvm names: on port ", R3
    ncall "io.print_s" (R4)
    ncall "io.nl" ()
    ncall "io.flush" ()
2:  ncall "net.accept" (R2) -> (R5)
    ncall "fs.give" (R5) -> (I5)
    spawn client (I5, I3)
    jmp 2b
.endf

; Names to ports, and to the process that holds each registration: a holder
; that ends takes its name with it. Calls: ["reg", name, port, holder] ->
; "OK" or "TAKEN"; ["port", name] -> [port or 0]; ["names"] -> [[name, port]...].
.func registry
    mnew R10                           ; name -> port
    mnew R11                           ; name -> holder
1:  recv R0
    isa I0, R0, Down
    bnz I0, gone
    mov R1, R0->Call.body
    mov R2, R1[0]
    strcmp I1, R2, "reg"
    bz I1, reg
    strcmp I1, R2, "port"
    bz I1, port
    lnew R3                            ; "names"
    mkeys R4, R10
    len I2, R4
    mov I3, 0
2:  bge I3, I2, 3f
    mov R5, R4[I3]
    mget I4, R10, R5
    lnew R6
    lpush R6, R5, I4
    lpush R3, R6
    inc I3
    jmp 2b
3:  ncall "proc.reply" (R0, R3)
    jmp 1b
reg:
    mov R5, R1[1]
    mov I4, R1[2]
    mov I5, R1[3]
    mhas I6, R10, R5
    bnz I6, taken
    mset R10, R5, I4
    mset R11, R5, I5
    monitor I5
    ncall "proc.reply" (R0, "OK")
    jmp 1b
taken:
    ncall "proc.reply" (R0, "TAKEN")
    jmp 1b
port:
    mov R5, R1[1]
    mget I4, R10, R5, 0
    lnew R6
    lpush R6, I4
    ncall "proc.reply" (R0, R6)
    jmp 1b
gone:                                  ; a holder ended: its names go
    mov I7, R0->Down.pid
    mkeys R4, R11
    len I2, R4
    mov I3, 0
4:  bge I3, I2, 1b
    mov R5, R4[I3]
    mget I4, R11, R5
    bne I4, I7, 5f
    mdel R10, R5
    mdel R11, R5
5:  inc I3
    jmp 4b
.endf

; One connection: one request.
.func client(i64 ticket, i64 reg)
    ncall "fs.take" (ticket) -> (R0)
.try lost
    ncall "fs.read_line" (R0) -> (R1)
    bz.r R1, done
    ncall "text.split" (R1, "") -> (R2)
    len I2, R2
    bz I2, bad
    mov R3, R2[0]
    strcmp I3, R3, "REGISTER"
    bz I3, register
    strcmp I3, R3, "PORT"
    bz I3, port
    strcmp I3, R3, "NAMES"
    bz I3, names
bad:
    ncall "fs.write" (R0, "ERROR\n")
    jmp done
register:
    bne I2, 3, bad
    call from_here (R0) -> (I4)
    bz I4, refused
    mov R4, R2[1]
    mov R5, R2[2]
    call port_of (R5) -> (I5)
    blt I5, 1, bad
    lnew R6
    lpush R6, "reg", R4, I5, PID
    ncall "proc.call" (reg, R6, 5000) -> (R7)
    strcat R8, R7, "\n"
    ncall "fs.write" (R0, R8)
    strcmp I6, R7, "OK"
    bnz I6, done
1:  ncall "fs.read_line" (R0) -> (R9)  ; held until the node closes it
    bnz.r R9, 1b
    jmp done
refused:
    ncall "fs.write" (R0, "REFUSED\n")
    jmp done
port:
    bne I2, 2, bad
    mov R4, R2[1]
    lnew R6
    lpush R6, "port", R4
    ncall "proc.call" (reg, R6, 5000) -> (R7)
    mov I5, R7[0]
    tostr R8, I5
    strcat R9, R8, "\n"
    ncall "fs.write" (R0, R9)
    jmp done
names:
    lnew R6
    lpush R6, "names"
    ncall "proc.call" (reg, R6, 5000) -> (R7)
    len I5, R7
    mov I6, 0
2:  bge I6, I5, 3f
    mov R8, R7[I6]
    mov R9, R8[0]
    mov I7, R8[1]
    tostr R10, I7
    strcat R11, R9, " ", R10, "\n"
    ncall "fs.write" (R0, R11)
    inc I6
    jmp 2b
3:  ncall "fs.write" (R0, "END\n")
done:
    ncall "fs.close" (R0)
.endtry
    ret
lost:
    catch R12
    ret
.endf

; A port, 1 to 65535, from its text; 0 if it is not one.
.func port_of(ref s) -> i64
.try no
    parse.i64 I0, s
.endtry
    blt I0, 1, 1f
    bgt I0, 65535, 1f
    ret I0
no:
    catch R1
1:  ret 0
.endf

; Whether a connection comes from this machine.
.func from_here(ref conn) -> i64
    ncall "net.peer" (conn) -> (R1, I1)
    strcmp I2, R1, "127.0.0.1"
    bz I2, 1f
    strcmp I2, R1, "::1"
    bz I2, 1f
    strcmp I2, R1, "::ffff:127.0.0.1"
    bz I2, 1f
    ret 0
1:  ret 1
.endf
