/* opcodes.def - THE single source of truth for the MLWSVM instruction set.
 *
 *   OP(ENUM, CODE, "mnemonic", "category", "pattern", typeset, flags, "doc")
 *
 * CODE is the stable 16-bit opcode number written to .mlwso files. Never renumber
 * an existing opcode; add new ones in a free slot of their category.
 *
 * The pattern describes each operand position (see opcodes.h for the letters):
 *   D dst (insn type)   S src (insn type)   V src (natural type unless typed)
 *   W dst (natural)     B bool dst          Q i64 src      A ptr src
 *   E ptr dst           M memory location   K string const I integer immediate
 *   L label             F function          N native name  C call block
 *   O object src (r)    X object dst (r)    J i64 dst      T struct type
 *   H f64 dst
 * BigInt (.big) and decimal (.dec) values are references held in R registers;
 * on non-arithmetic instructions those suffixes behave like .r.
 * A trailing modifier applies to the last letter: ? optional, * zero or more,
 * + one or more. The operand count limits (0..32) are derived from the pattern.
 *
 * Arithmetic convention: with exactly two operands, `op dst, src` means
 * dst = dst OP src; with three or more, dst = s1 OP s2 OP ... OP sN.
 * Operands are evaluated left to right, the destination location first.
 *
 * The descriptions below are copied verbatim into docs/ISA.md by `mlwsvm doc isa`.
 */

/* ---- control ----------------------------------------------------------- */
OP(NOP,    0x0000, "nop",    "Control", "",    0, 0,
   "Do nothing.")
OP(HALT,   0x0001, "halt",   "Control", "Q?",  0, OPF_TERM,
   "Stop the current process with the given exit code (default 0).")
OP(BREAK,  0x0002, "break",  "Control", "",    0, 0,
   "Debugger breakpoint. A no-op when no debugger is attached.")
OP(ASSERT, 0x0003, "assert", "Control", "QK?", 0, 0,
   "Trap with E_ASSERT if the first operand is zero. The optional second operand is a message string.")

/* ---- data movement ------------------------------------------------------ */
OP(MOV,    0x0010, "mov",    "Data movement", "DS", TS_ANY, OPF_NATURAL,
   "dst = src. Untyped memory-to-memory moves copy the source word together with its type tag.")
OP(SWAP,   0x0011, "swap",   "Data movement", "DD", TS_ANY, OPF_NATURAL,
   "Exchange the contents of two locations.")
OP(LEA,    0x0012, "lea",    "Data movement", "EM", 0, 0,
   "dst = the address of a memory operand, as a pointer. `lea P0, SP[2]` makes P0 point 2 words above SP.")
OP(PUSH,   0x0013, "push",   "Data movement", "V+", TS_ANY, OPF_PERVAL,
   "Push each operand onto the data stack, left to right: for each, SP -= 1 word, then [SP] = value. Untyped pushes use each operand's natural type (I=i64, F=f64, R=r, P=p, int literal=i64, float literal=f64, string=r, memory=its tag).")
OP(POP,    0x0014, "pop",    "Data movement", "W+", TS_ANY, OPF_PERVAL,
   "Pop into each operand, left to right: for each, dst = [SP], then SP += 1 word. `push a, b` is undone by `pop b, a`.")
OP(DROP,   0x0015, "drop",   "Data movement", "I?", 0, 0,
   "Discard n words (default 1) from the top of the data stack: SP += n words.")
OP(ENTER,  0x0016, "enter",  "Data movement", "I",  0, 0,
   "Reserve n zeroed words of locals: SP -= n words. Locals are then addressed as LOC[0]..LOC[n-1] (FP[-1]..FP[-n]).")
OP(CVT,    0x0017, "cvt",    "Data movement", "DS", TS_NUM | TS_BIGDEC, OPF_TYPE2,
   "Value conversion `cvt.<to>.<from> dst, src`. int->int wraps or extends, int->float rounds, float->int truncates toward zero and saturates (NaN becomes 0), to-bool tests for non-zero.")
OP(BITCAST,0x0018, "bitcast","Data movement", "DS", TS_NUM, OPF_TYPE2,
   "Reinterpret the bits of src as dst's type: `bitcast.<to>.<from>`. Both types must have the same size, e.g. bitcast.i64.f64 or bitcast.f32.u32.")
OP(LDV,    0x0019, "ldv",    "Data movement", "JHV", 0, 0,
   "Load a number into the destination its type tag picks: `ldv I0, F0, R1[I2]` sets I0 (as i64) if the slot holds an integer (b, c, i8 ... u64) and F0 (as f64) if it holds a float, and leaves the other unchanged. A slot never written reads as the integer 0; any other type traps E_TYPE. This reads the number half of a dynamically typed value without a branch on its type.")

/* ---- arithmetic --------------------------------------------------------- */
OP(ADD,    0x0020, "add",    "Arithmetic", "DS+", TS_NUM | TS_PTR | TS_BIGDEC, 0,
   "Sum. `add dst, s` means dst += s; `add dst, s1, s2, ...` means dst = s1 + s2 + .... For add.p the first value is a pointer and the remaining values are i64 byte offsets.")
OP(SUB,    0x0021, "sub",    "Arithmetic", "DS+", TS_NUM | TS_PTR | TS_BIGDEC, 0,
   "Difference: dst = s1 - s2 - ... (two-operand form: dst -= s). sub.p subtracts i64 byte offsets from a pointer.")
OP(MUL,    0x0022, "mul",    "Arithmetic", "DS+", TS_NUM | TS_BIGDEC, 0,
   "Product: dst = s1 * s2 * ... (two-operand form: dst *= s). Integer multiply wraps.")
OP(DIV,    0x0023, "div",    "Arithmetic", "DS+", TS_NUM | TS_BIGDEC, 0,
   "Quotient, left to right. Integer division truncates toward zero and traps E_DIV_ZERO on a zero divisor. Float division follows IEEE 754.")
OP(REM,    0x0024, "rem",    "Arithmetic", "DS+", TS_NUM | TS_BIGDEC, 0,
   "Remainder with the sign of the dividend (C semantics; fmod for floats). Integer remainder traps E_DIV_ZERO on a zero divisor.")
OP(MIN,    0x0025, "min",    "Arithmetic", "DS+", TS_NUM | TS_BIGDEC, 0,
   "Smallest of the sources (two-operand form: dst = min(dst, s)).")
OP(MAX,    0x0026, "max",    "Arithmetic", "DS+", TS_NUM | TS_BIGDEC, 0,
   "Largest of the sources (two-operand form: dst = max(dst, s)).")
OP(NEG,    0x0027, "neg",    "Arithmetic", "DS?", TS_NUM | TS_BIGDEC, 0,
   "dst = -src (one-operand form negates in place).")
OP(ABS,    0x0028, "abs",    "Arithmetic", "DS?", TS_NUM | TS_BIGDEC, 0,
   "dst = |src| (one-operand form works in place). abs of the minimum signed value wraps to itself.")
OP(INC,    0x0029, "inc",    "Arithmetic", "D",   TS_NUM, 0,
   "dst += 1.")
OP(DEC,    0x002A, "dec",    "Arithmetic", "D",   TS_NUM, 0,
   "dst -= 1.")

/* ---- bitwise ------------------------------------------------------------- */
OP(AND,    0x0040, "and",    "Bitwise", "DS+", TS_INT, 0,
   "Bitwise AND of the sources (two-operand form: dst &= s).")
OP(OR,     0x0041, "or",     "Bitwise", "DS+", TS_INT, 0,
   "Bitwise OR of the sources (two-operand form: dst |= s).")
OP(XOR,    0x0042, "xor",    "Bitwise", "DS+", TS_INT, 0,
   "Bitwise XOR of the sources (two-operand form: dst ^= s).")
OP(NOT,    0x0043, "not",    "Bitwise", "DS?", TS_INT, 0,
   "Bitwise complement (logical NOT for .b). The one-operand form works in place.")
OP(SHL,    0x0044, "shl",    "Bitwise", "DSS?", TS_INT, 0,
   "Shift left: `shl dst, n` or `shl dst, src, n`. The count is taken modulo the type's bit width.")
OP(SHR,    0x0045, "shr",    "Bitwise", "DSS?", TS_INT, 0,
   "Logical shift right within the type's width (zero fill).")
OP(SAR,    0x0046, "sar",    "Bitwise", "DSS?", TS_INT, 0,
   "Arithmetic shift right within the type's width (sign fill).")
OP(ROL,    0x0047, "rol",    "Bitwise", "DSS?", TS_INT, 0,
   "Rotate left within the type's width.")
OP(ROR,    0x0048, "ror",    "Bitwise", "DSS?", TS_INT, 0,
   "Rotate right within the type's width.")
OP(POPCNT, 0x0049, "popcnt", "Bitwise", "DS?", TS_INT, 0,
   "Number of set bits within the type's width.")
OP(CLZ,    0x004A, "clz",    "Bitwise", "DS?", TS_INT, 0,
   "Count leading zero bits within the type's width (the width itself for 0).")
OP(CTZ,    0x004B, "ctz",    "Bitwise", "DS?", TS_INT, 0,
   "Count trailing zero bits (the type's width for 0).")
OP(BSWAP,  0x004C, "bswap",  "Bitwise", "DS?", TS_INT, 0,
   "Reverse the byte order within the type's width.")

/* ---- floating point ------------------------------------------------------ */
OP(SQRT,   0x0050, "sqrt",   "Floating point", "DS?", TS_FLT, 0,
   "Square root.")
OP(FLOOR,  0x0051, "floor",  "Floating point", "DS?", TS_FLT, 0,
   "Round toward negative infinity.")
OP(CEIL,   0x0052, "ceil",   "Floating point", "DS?", TS_FLT, 0,
   "Round toward positive infinity.")
OP(ROUND,  0x0053, "round",  "Floating point", "DS?", TS_FLT, 0,
   "Round to nearest, with ties away from zero.")
OP(TRUNC,  0x0054, "trunc",  "Floating point", "DS?", TS_FLT, 0,
   "Round toward zero.")
OP(FMA,    0x0055, "fma",    "Floating point", "DSSS", TS_FLT, 0,
   "Fused multiply-add: dst = a * b + c with a single rounding.")

/* ---- comparison ---------------------------------------------------------- */
OP(SEQ,    0x0060, "seq",    "Comparison", "BSS", TS_ANY, 0,
   "dst = (a == b) as bool. References compare by identity.")
OP(SNE,    0x0061, "sne",    "Comparison", "BSS", TS_ANY, 0,
   "dst = (a != b) as bool.")
OP(SLT,    0x0062, "slt",    "Comparison", "BSS", TS_ORD, 0,
   "dst = (a < b) as bool, using the instruction type's signedness. Any comparison involving NaN is false.")
OP(SLE,    0x0063, "sle",    "Comparison", "BSS", TS_ORD, 0,
   "dst = (a <= b) as bool.")
OP(SGT,    0x0064, "sgt",    "Comparison", "BSS", TS_ORD, 0,
   "dst = (a > b) as bool.")
OP(SGE,    0x0065, "sge",    "Comparison", "BSS", TS_ORD, 0,
   "dst = (a >= b) as bool.")
OP(SEL,    0x0066, "sel",    "Comparison", "DQSS", TS_ANY, 0,
   "Select: dst = cond != 0 ? a : b. Only the chosen source is read.")

/* ---- branches ------------------------------------------------------------ */
OP(JMP,    0x0070, "jmp",    "Branches", "L", 0, OPF_TERM,
   "Jump unconditionally.")
OP(BZ,     0x0071, "bz",     "Branches", "SL", TS_INT | TS_REF | TS_PTR, 0,
   "Branch if the value is zero, false or null.")
OP(BNZ,    0x0072, "bnz",    "Branches", "SL", TS_INT | TS_REF | TS_PTR, 0,
   "Branch if the value is non-zero, true or non-null.")
OP(BEQ,    0x0073, "beq",    "Branches", "SSL", TS_ANY, 0,
   "Branch if a == b.")
OP(BNE,    0x0074, "bne",    "Branches", "SSL", TS_ANY, 0,
   "Branch if a != b.")
OP(BLT,    0x0075, "blt",    "Branches", "SSL", TS_ORD, 0,
   "Branch if a < b, using the instruction type's signedness.")
OP(BLE,    0x0076, "ble",    "Branches", "SSL", TS_ORD, 0,
   "Branch if a <= b.")
OP(BGT,    0x0077, "bgt",    "Branches", "SSL", TS_ORD, 0,
   "Branch if a > b.")
OP(BGE,    0x0078, "bge",    "Branches", "SSL", TS_ORD, 0,
   "Branch if a >= b.")
OP(JTAB,   0x0079, "jtab",   "Branches", "QL+", 0, 0,
   "Jump table: `jtab idx, L0, L1, ..., Ln` jumps to L<idx>. If idx is out of range, execution falls through to the next instruction.")
OP(BISA,   0x007A, "bisa",   "Branches", "OTL", 0, 0,
   "Branch if the reference is a struct of the given type: `bisa R1, Point, L`. One instruction for `isa` and `bnz`.")
OP(BNISA,  0x007B, "bnisa",  "Branches", "OTL", 0, 0,
   "Branch unless the reference is a struct of the given type (null included): `bnisa R1, Point, L`. One instruction for `isa` and `bz`, the guard before a struct's fields are read.")

/* ---- calls --------------------------------------------------------------- */
OP(CALL,   0x0080, "call",   "Calls", "FC", 0, OPF_CALL,
   "Call a function: `call f (a1, a2, ...) -> (d1, d2, ...)`. Each argument is read with the callee's declared parameter type and bound to the callee's next free register of that bank (int-class args to I0, I1, ...; floats to F0, ...; refs to R0, ...; pointers to P0, ...). Return values are written to d1, d2, .... The callee gets fresh registers, and FP = SP at the call.")
OP(TCALL,  0x0081, "tcall",  "Calls", "FC", 0, OPF_CALL | OPF_TERM,
   "Tail call: like call, but replaces the current frame. The callee's return values go to the current function's caller. A tail call cannot have result operands.")
OP(RET,    0x0082, "ret",    "Calls", "V*", 0, OPF_TERM | OPF_PERVAL,
   "Return from the current function with zero or more values. Operands are read with the function's declared return types (or their natural types if none are declared). SP is restored to its value at the call.")
OP(NCALL,  0x0083, "ncall",  "Calls", "NC", 0, OPF_CALL,
   "Call a native (host) function by name: `ncall \"io.print_i\" (I0)`. See docs/NATIVES.md for the built-in natives, and docs/EXTENDING.md for natives from extensions (`.extension`) and C functions (`.extern`). Errors in foreign code are raised once it returns; a blocking one runs on the I/O thread pool while this process waits.")

/* ---- raw memory ---------------------------------------------------------- */
OP(ALLOC,  0x0090, "alloc",  "Raw memory", "EQ", 0, 0,
   "Allocate a zeroed raw memory block of n bytes. dst = pointer to it. Raw blocks are bounds checked and owned by the process, and are released when it exits.")
OP(FREE,   0x0091, "free",   "Raw memory", "A", 0, 0,
   "Free a raw block. Freeing null is a no-op. Freeing anything other than the start of a live block traps E_BAD_FREE. Any later use of the pointer traps E_UAF.")
OP(REALLOC,0x0092, "realloc","Raw memory", "EAQ", 0, 0,
   "Resize a raw block: `realloc dst, ptr, n`. The contents are preserved up to the smaller size and new bytes are zeroed. Old pointers into the block become invalid (E_UAF).")
OP(MEMCPY, 0x0093, "memcpy", "Raw memory", "AAQ", 0, 0,
   "Copy n bytes: `memcpy dst_ptr, src_ptr, n` (the regions may overlap). Copied bytes are untyped: they cannot later be read as references.")
OP(MEMSET, 0x0094, "memset", "Raw memory", "AQQ", 0, 0,
   "Fill n bytes with a byte value: `memset ptr, byte, n`.")

/* ---- objects -------------------------------------------------------------- */
OP(NEW,    0x00A0, "new",    "Objects", "XT", 0, 0,
   "Allocate a struct with every field zero (0, 0.0 or null): `new R0, Point`. Fields are then accessed as R0->Point.x.")
OP(ANEW,   0x00A1, "anew",   "Objects", "XQ", TS_ANY, 0,
   "Allocate an array of n zeroed elements of the instruction type: `anew.f64 R0, 100`. Elements are accessed as R0[I1] or R0[5] and are bounds checked.")
OP(LEN,    0x00A2, "len",    "Objects", "JO", 0, 0,
   "Length: bytes of a string or byte buffer, elements of an array or list, entries of a map. Traps E_TYPE for a struct and E_NULL for null.")
OP(TYPEOF, 0x00A3, "typeof", "Objects", "JO", 0, 0,
   "Kind of a reference: 0 null, 1 string, 2 bytes, 3 array, 4 struct, 5 list, 6 map, 7 closure, 8 BigInt, 9 decimal, 10 foreign handle, 11 coroutine.")
OP(ISA,    0x00A4, "isa",    "Objects", "BOT", 0, 0,
   "dst = true if the reference is a struct of the given type: `isa I0, R1, Point`.")
OP(RESIZE, 0x00A5, "resize", "Objects", "OQ", 0, 0,
   "Set the length of a byte buffer or list. New bytes are 0. New list elements are untyped zeros, which read as 0, 0.0 or null.")
OP(TAGOF,  0x00A6, "tagof",  "Objects", "JV", 0, 0,
   "dst = the type a slot holds, as a type code (0 for a slot never written, 255 for raw bytes; see Types in docs/ISA.md): a list element or closure capture its own tag, an array element or struct field its declared type, a stack or global word its tag, a byte of a string or buffer u8, a register or constant its natural type. With this, one tagged slot can hold a dynamically typed value: `tagof I0, R1[I2]`, then branch and read it with its type.")

/* ---- strings and bytes ------------------------------------------------------ */
OP(STRCAT, 0x00B0, "strcat", "Strings", "XO+", 0, 0,
   "Concatenate strings and/or byte buffers into a new string: `strcat R0, R1, \"-\", R2` (up to 31 parts). `strcat R0, buf` copies a byte buffer into a string.")
OP(SUBSTR, 0x00B1, "substr", "Strings", "XOQQ", 0, 0,
   "`substr dst, s, start, n`: new string of the n bytes starting at byte offset start. Traps E_BOUNDS if the range is outside s.")
OP(STRCMP, 0x00B2, "strcmp", "Strings", "JOO", 0, 0,
   "Compare two strings or byte buffers bytewise: dst = -1, 0 or 1.")
OP(STRFIND,0x00B3, "strfind","Strings", "JOOQ?", 0, 0,
   "`strfind dst, s, needle [, start]`: byte offset of the first occurrence of needle at or after start (default 0), or -1.")
OP(TOSTR,  0x00B4, "tostr",  "Strings", "XV", TS_ANY, OPF_PERVAL,
   "Convert a value to a new string, using the instruction type or the value's natural type: integers in decimal, floats in shortest round-trip form, bools as true/false, chars as UTF-8. A string converts to itself, a byte buffer to a copy, and other objects to a description such as <list len=3>.")
OP(PARSE,  0x00B5, "parse",  "Strings", "DO", TS_NUM | TS_BIGDEC, 0,
   "Parse a number from the whole string: `parse.i64 I0, s` (decimal, or 0x/0b/0o prefixed), `parse.f64 F0, s`. Anything else traps E_PARSE.")
OP(BUFNEW, 0x00B6, "bufnew", "Strings", "XQ", 0, 0,
   "New mutable byte buffer of n zero bytes. Its bytes are accessed as R0[I1] (u8).")
OP(BUFCAT, 0x00B7, "bufcat", "Strings", "OO+", 0, 0,
   "Append strings and/or byte buffers to a byte buffer: `bufcat buf, s1, s2, ...`.")
OP(BUFPUSH,0x00B8, "bufpush","Strings", "OQ+", 0, 0,
   "Append byte values (the low 8 bits of each operand) to a byte buffer.")

/* ---- lists and maps --------------------------------------------------------- */
OP(LNEW,   0x00C0, "lnew",   "Lists and maps", "XQ?", 0, 0,
   "New empty list, with an optional initial capacity.")
OP(LPUSH,  0x00C1, "lpush",  "Lists and maps", "OV+", TS_ANY, OPF_PERVAL,
   "Append values to a list. Each element remembers its type: untyped operands use their natural type, typed ones (lpush.i32) the instruction type.")
OP(LPOP,   0x00C2, "lpop",   "Lists and maps", "WO", TS_ANY, OPF_PERVAL,
   "Remove the last element of a list into dst: `lpop dst, list`. Traps E_BOUNDS on an empty list.")
OP(LINS,   0x00C3, "lins",   "Lists and maps", "OQV", TS_ANY, OPF_PERVAL,
   "Insert a value before index i (0..len): `lins list, i, value`.")
OP(LDEL,   0x00C4, "ldel",   "Lists and maps", "OQ", 0, 0,
   "Delete the element at index i, shifting later elements down.")
OP(MNEW,   0x00C5, "mnew",   "Lists and maps", "X", 0, 0,
   "New empty map. Maps iterate in insertion order.")
OP(MSET,   0x00C6, "mset",   "Lists and maps", "OVV", TS_ANY, OPF_PERVAL,
   "`mset map, key, value`. Keys compare by value: integers of any width by value, floats by value, strings by content, other references by identity, pointers by value. A type suffix applies to the value.")
OP(MGET,   0x00C7, "mget",   "Lists and maps", "WOVV?", TS_ANY, OPF_PERVAL,
   "`mget dst, map, key [, default]`. A missing key yields the default if given, and otherwise traps E_KEY. A type suffix applies to the value and the default.")
OP(MHAS,   0x00C8, "mhas",   "Lists and maps", "BOV", 0, 0,
   "dst = true if the map contains the key.")
OP(MDEL,   0x00C9, "mdel",   "Lists and maps", "OV", 0, 0,
   "Remove a key from a map (no effect if it is absent).")
OP(MKEYS,  0x00CA, "mkeys",  "Lists and maps", "XO", 0, 0,
   "New list of a map's keys, in insertion order.")

/* ---- handles ------------------------------------------------------------- */
OP(HNEW,   0x00D0, "hnew",   "Handles", "JO", 0, 0,
   "Make a handle: an i64 that keeps the object alive and can be stored anywhere, including raw memory. Freed handle numbers may be reused.")
OP(HGET,   0x00D1, "hget",   "Handles", "XQ", 0, 0,
   "Get a handle's object. Traps E_BAD_HANDLE for an unknown or freed handle.")
OP(HFREE,  0x00D2, "hfree",  "Handles", "Q", 0, 0,
   "Release a handle. The object becomes collectable if nothing else refers to it.")

/* ---- exceptions ------------------------------------------------------------ */
OP(THROW,  0x00E0, "throw",  "Exceptions", "O", 0, OPF_TERM,
   "Raise an exception: any non-null reference, often an Error struct (`new R0, Error`). Control passes to the handler of the innermost enclosing .try region in this function or a caller, and frames without a handler are unwound. An uncaught exception ends the process. To rethrow, throw the caught value again.")
OP(CATCH,  0x00E1, "catch",  "Exceptions", "X", 0, 0,
   "At the start of a handler: dst = the exception being handled. Runtime faults arrive as Error structs whose code field holds the error code (e.g. \"E_DIV_ZERO\").")

/* ---- processes ------------------------------------------------------------- */
OP(SPAWN,  0x0100, "spawn",  "Processes", "FC", 0, OPF_CALL,
   "Start a new process running a function: `spawn worker (a, b) -> (I0)` puts the new process id in I0. Arguments are copied into the new process; references are deep-copied, and pointers cannot be passed. The new process inherits this process's quotas and may start running at once, on another thread. To watch or link to it, use spawnm or spawnl: with `spawn` followed by `monitor`, a quick child can finish first.")
OP(SEND,   0x0101, "send",   "Processes", "QV", TS_ANY, OPF_PERVAL,
   "`send pid, value`: append a copy of value to the mailbox of process pid. References are deep-copied, preserving sharing and cycles. Sending to a finished process does nothing. Traps E_QUOTA if the receiver's mailbox is full and E_TYPE for a pointer.")
OP(RECV,   0x0102, "recv",   "Processes", "W", TS_ANY, OPF_PERVAL,
   "Take the oldest message from this process's mailbox, waiting until one arrives. The message keeps its type (as list elements do). Traps E_DEADLOCK if every process is waiting and none can ever send.")
OP(RECVT,  0x0103, "recvt",  "Processes", "WQL", TS_ANY, OPF_PERVAL,
   "`recvt dst, ms, Ltimeout`: like recv, but if no message arrives within ms milliseconds, jump to Ltimeout instead. ms = 0 polls.")
OP(YIELD,  0x0104, "yield",  "Processes", "", 0, 0,
   "Give the rest of this time slice to other processes.")
OP(SLEEP,  0x0105, "sleep",  "Processes", "Q", 0, 0,
   "Suspend this process for at least the given number of milliseconds.")
OP(KILL,   0x0106, "kill",   "Processes", "Q", 0, 0,
   "Terminate a process with error E_KILLED (as a failure, so links and monitors are notified). Killing a finished or unknown process does nothing; killing yourself ends this process.")
OP(LINK,   0x0107, "link",   "Processes", "Q", 0, 0,
   "Link this process and another. If either fails (an uncaught exception, kill or quota), the other is killed with E_LINKED. Normal exits do not propagate.")
OP(MONITOR,0x0108, "monitor","Processes", "Q", 0, 0,
   "Watch a process. When it ends, this process receives a Down struct message with fields pid, exit (exit code), and code/message (null for a normal exit). Monitoring a finished or unknown process delivers a Down message immediately, with code E_NOPROC.")
OP(ALIVE,  0x0109, "alive",  "Processes", "BQ", 0, 0,
   "dst = true if the process exists and has not finished.")
OP(QUOTA,  0x010A, "quota",  "Processes", "IQ", 0, 0,
   "`quota kind, limit` lowers one of this process's limits (it can never raise them): 0 heap bytes, 1 raw-memory bytes, 2 mailbox messages, 3 instructions executed, 4 foreign calls (natives from extensions and .extern; 0 forbids native code), 5 OS calls (fs.* and os.*; 0 forbids files, commands and the environment). Processes it spawns inherit its limits (and count their own use). Exceeding a limit traps E_QUOTA.")
OP(MLEN,   0x010B, "mlen",   "Processes", "J", 0, 0,
   "dst = the number of messages waiting in this process's mailbox.")
OP(SPAWNL, 0x010C, "spawnl", "Processes", "FC", 0, OPF_CALL,
   "Like spawn, and the new process is linked to this one before it starts (see link), so it cannot fail unnoticed in between.")
OP(SPAWNM, 0x010D, "spawnm", "Processes", "FC", 0, OPF_CALL,
   "Like spawn, and this process monitors the new one from the start (see monitor): a Down message reports how it ends, however quickly.")

/* ---- closures ---------------------------------------------------------------- */
OP(CLOSURE,0x0110, "closure","Closures", "FC", 0, OPF_CALL,
   "Make a function value: `closure f (v1, v2, ...) -> (R0)`. The values are copied into the closure, and f reads and writes them as UP[0], UP[1], .... Each keeps its own type, as a list element does. Captures are copies: to share a mutable variable, capture a struct or list.")
OP(CALLI,  0x0111, "calli",  "Closures", "OC", 0, OPF_CALL,
   "Call through a closure: `calli R0 (args) -> (results)`. Arguments are read with the function's parameter types; the count and register banks are checked at run time (E_TYPE).")
OP(TCALLI, 0x0112, "tcalli", "Closures", "OC", 0, OPF_CALL | OPF_TERM,
   "Tail call through a closure (like tcall).")
OP(SPAWNI, 0x0113, "spawni", "Closures", "OC", 0, OPF_CALL,
   "Start a new process running a closure: `spawni R0 (args) -> (pid)`. The closure and its captures are deep-copied into the new process.")
OP(SPAWNIL,0x0114, "spawnil","Closures", "OC", 0, OPF_CALL,
   "spawni, linked to the new process from the start (as spawnl).")
OP(SPAWNIM,0x0115, "spawnim","Closures", "OC", 0, OPF_CALL,
   "spawni, monitoring the new process from the start (as spawnm).")

/* ---- coroutines ---------------------------------------------------------------- */
OP(CONEW,  0x0120, "conew",  "Coroutines", "XOQ?", 0, 0,
   "Make a coroutine that will run a closure: `conew R0, R1 [, words]`. It starts suspended; the first coresume calls the closure. It has its own registers, call frames and data stack (words 8-byte words, default 1024), and shares the heap, globals and raw memory with the rest of the process. Its stack is charged to the heap quota.")
OP(CORESUME,0x0121,"coresume","Coroutines", "OC", 0, OPF_CALL,
   "Run a suspended coroutine until it yields, returns or throws: `coresume R0 (args) -> (results)`. The first resume passes the arguments to the closure as a calli would; later ones deliver them to the results of the coyield it is suspended at. The results are its coyield values, or its return values once it finishes (it is then dead). An exception it does not catch kills it and is thrown again here. Resuming a coroutine that is running, normal (it resumed another) or dead traps E_CORO; resuming inside a callback from C traps E_CALLBACK.")
OP(COYIELD,0x0122, "coyield","Coroutines", "C", 0, OPF_CALL,
   "Suspend the running coroutine: `coyield (values) -> (results)`. Its resumer's coresume receives the values; the next coresume's arguments arrive in results. Values keep their natural types (as an untyped ret's), and a destination of the wrong bank traps E_TYPE, too few values E_RET_COUNT. Outside a coroutine it traps E_CORO, inside a callback from C E_CALLBACK.")
OP(COSTATUS,0x0123,"costatus","Coroutines", "JO", 0, 0,
   "dst = a coroutine's state: 0 suspended (or not yet started), 1 running, 2 normal (it resumed another coroutine), 3 dead (it returned, threw or was closed).")
OP(COCUR,  0x0124, "cocur",  "Coroutines", "X", 0, 0,
   "dst = the running coroutine, or null outside one.")
OP(COCLOSE,0x0125, "coclose","Coroutines", "O", 0, 0,
   "Kill a suspended coroutine and free its stack at once (its .try handlers do not run). Closing a dead one does nothing; closing a running or normal one traps E_CORO.")
