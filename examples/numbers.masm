; numbers.masm - integers that do not overflow, decimals for money, and
; floats, side by side.
;
;     mlwsvm run examples/numbers.masm
;
; i64 arithmetic is a machine's: fast, and wrapping around past the largest
; value, as in C. BigInts (`.big`, literals like 123n) grow as needed, and a
; BigInt too large to convert back to i64 raises E_OVERFLOW. Decimals (`.dec`, literals like 0.10d)
; are exact in base ten, so 0.1 + 0.2 is 0.3 and cents add up; division that
; does not end stops at 28 places, rounded half to even, and dec.round rounds
; to any number of places in the mode a ledger needs. Floats (f64) are
; IEEE 754 doubles, printed in the fewest digits that read back the same.
;
; expect-stdout: 25! = 15511210043330985984000000
; expect-stdout: 2^100 = 1267650600228229401496703205376
; expect-stdout: i64: 9223372036854775807 + 1 = -9223372036854775808
; expect-stdout: big: 9223372036854775807 + 1 = 9223372036854775808
; expect-stdout: back to i64: E_OVERFLOW
; expect-stdout: f64: 0.1 + 0.2 = 0.30000000000000004
; expect-stdout: dec: 0.1 + 0.2 = 0.3
; expect-stdout: 3 items at 19.99, with 8.25% tax: 64.92
; expect-stdout: 1 / 3 = 0.3333333333333333333333333333
.include "std/io.inc"

; factorial(n) -> n!, as a BigInt
.func factorial(i64 n) -> ref
    mov.big R0, 1
    mov I1, 2
1:  bgt I1, n, 2f
    cvt.big.i64 R1, I1
    mul.big R0, R1
    inc I1
    jmp 1b
2:  ret R0
.endf

.func main
    call factorial (25) -> (R0)
    tostr R1, R0
    strcat R1, "25! = ", R1
    PRINTLN_S R1

    mov.big R0, 1
    mov I1, 0
1:  mul.big R0, 2
    inc I1
    blt I1, 100, 1b
    tostr R1, R0
    strcat R1, "2^100 = ", R1
    PRINTLN_S R1

    mov I0, 9223372036854775807        ; the largest i64
    add I1, I0, 1                      ; wraps around
    tostr R1, I1
    strcat R1, "i64: 9223372036854775807 + 1 = ", R1
    PRINTLN_S R1
    cvt.big.i64 R0, I0
    add.big R0, 1                      ; grows
    tostr R1, R0
    strcat R1, "big: 9223372036854775807 + 1 = ", R1
    PRINTLN_S R1
.try overflowed
    cvt.i64.big I1, R0                 ; does not fit
.endtry
    PRINTLN_S "unexpected: it fit"
    ret 1
overflowed:
    catch R2
    strcat R1, "back to i64: ", R2->Error.code
    PRINTLN_S R1

    add F0, 0.1, 0.2
    tostr R1, F0
    strcat R1, "f64: 0.1 + 0.2 = ", R1
    PRINTLN_S R1
    add R0, 0.1d, 0.2d
    tostr R1, R0
    strcat R1, "dec: 0.1 + 0.2 = ", R1
    PRINTLN_S R1

    mul.dec R0, 19.99d, 3              ; 59.97
    mul.dec R3, R0, 0.0825d            ; the tax, exactly: 4.947525
    add.dec R3, R0                     ; 64.917525
    ncall "dec.round" (R3, 2, "half_up") -> (R3)   ; to cents: 64.92
    tostr R1, R3
    strcat R1, "3 items at 19.99, with 8.25% tax: ", R1
    PRINTLN_S R1

    div.dec R0, 1, 3
    tostr R1, R0
    strcat R1, "1 / 3 = ", R1
    PRINTLN_S R1
    ret 0
.endf
