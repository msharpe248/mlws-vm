; cat.masm - copy files, or standard input, to standard output, as Unix's cat.
;
;     mlwsvm run examples/cat.masm [FILE...]
;     echo hello | mlwsvm run examples/cat.masm
;
; With no files it copies standard input; a file named "-" is standard input
; too. It reads 64 KiB at a time and writes each piece as it comes, so a file
; of any size is copied in the same small memory, and a pipe's input as soon as
; it arrives. A file that cannot be read is reported on standard error, the
; others are still copied, and the exit code is 1.
;
; A read of standard input or of a file runs on the VM's I/O pool: the process
; waits, but its worker thread goes on running other processes
; (docs/STDLIB.md, "How I/O waits").
;
; args: - examples/data/poem.txt examples/data/none.txt
; stdin: Line one, from standard input.
; stdin: Line two.
; expect-stdout: Line one, from standard input.
; expect-stdout: Line two.
; expect-stdout: The fog comes
; expect-stdout: on little cat feet.
; expect-exit: 1

; copy(from, to): every byte of `from`, until its end, written to `to`
.func copy(ref from, ref to)
1:  ncall "fs.read" (from, 65536) -> (R2)   ; a byte buffer: empty at the end
    len I0, R2
    bz I0, 2f
    ncall "fs.write" (to, R2)
    jmp 1b
2:  ret
.endf

; cat(name, out) -> 0, or 1 if the file could not be read
.func cat(ref name, ref out) -> i64
    strcmp I0, name, "-"
    bnz I0, 1f
    ncall "fs.stdin" () -> (R2)
    call copy (R2, out)
    ret 0
1:
.try failed
    ncall "fs.open" (name, "r") -> (R2)
    call copy (R2, out)
.endtry
    ncall "fs.close" (R2)
    ret 0
failed:
    catch R3                           ; an Error: its code and message
    ncall "fs.stderr" () -> (R4)
    strcat R5, "cat: ", R3->Error.message, "\n"     ; "fs.open: NAME: why"
    ncall "fs.write" (R4, R5)
    ret 1
.endf

.func main
    .alias args, R0
    .alias out, R1
    .alias n, I0
    .alias i, I1
    .alias status, I2
    ncall "os.args" () -> (args)
    ncall "fs.stdout" () -> (out)
    len n, args
    bnz n, 1f
    call cat ("-", out) -> (status)     ; no files: standard input
    ret status
1:  mov status, 0
    mov i, 0
2:  bge i, n, 3f
    mov R3, args[i]
    call cat (R3, out) -> (I3)
    or status, I3
    add i, 1
    jmp 2b
3:  ret status
.endf
