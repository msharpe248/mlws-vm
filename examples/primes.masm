; primes.masm - a pool of workers (std.pool): the primes below 2,000,000,
; counted in 20 ranges, at most 4 at a time.
;
;     mlwsvm run examples/primes.masm
;
; pool.map hands the ranges to the pool, which runs each on a free worker as
; soon as one is free, and gives the counts back in the order of the ranges.
; Four workers use at most four of the machine's cores, however many ranges
; there are; workers.masm does the same work with a process per range and
; nothing to hold them back.
;
; expect-stdout: 20 ranges: 78498 primes below 1000000, 148933 below 2000000
.include "std/io.inc"
.import std.pool as pool

; count([from, to]) -> [how many primes are in from..to-1], by trial division
.func count(ref range) -> ref
    mov I1, range[0]
    mov I2, range[1]
    mov I3, 0                          ; primes found
1:  bge I1, I2, 5f
    blt I1, 2, 4f
    mov I4, 2
2:  mul I5, I4, I4
    bgt I5, I1, 3f                     ; no divisor up to its square root: prime
    rem I6, I1, I4
    bz I6, 4f
    inc I4
    jmp 2b
3:  inc I3
4:  inc I1
    jmp 1b
5:  lnew R2
    lpush R2, I3
    ret R2
.endf

.func main
    closure count -> (R0)
    call pool.start (R0, 4) -> (I0)
    lnew R1                            ; [0, 100000], [100000, 200000], ...
    mov I1, 0
1:  lnew R2
    add I2, I1, 100000
    lpush R2, I1, I2
    lpush R1, R2
    mov I1, I2
    blt I1, 2000000, 1b
    call pool.map (I0, R1, -1) -> (R3)  ; (no time limit)
    mov I3, 0                          ; the sums: below 1,000,000 and below 2,000,000
    mov I4, 0
    mov I5, 0
2:  mov R4, R3[I5]
    mov I6, R4[0]
    add I4, I6
    inc I5
    bne I5, 10, 3f
    mov I3, I4
3:  blt I5, 20, 2b
    send I0, "stop"
    lnew R5
    len I7, R3
    lpush R5, I7, I3, I4
    ncall "text.format" ("{} ranges: {} primes below 1000000, {} below 2000000", R5) -> (R6)
    PRINTLN_S R6
    ret 0
.endf
